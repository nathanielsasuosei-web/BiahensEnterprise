{
  "name": "pointgh",
  "version": "1.0.0",
  "private": true,
  "description": "POINTGH - owner-managed e-commerce for Ghana",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test tests/*.test.js",
    "db:init": "node src/db/migrate.js",
    "db:seed": "node src/db/seed.js",
    "db:reset": "node src/db/reset.js",
    "vercel:build": "node scripts/vercel-build.js",
    "vercel:dev": "vercel dev",
    "notifications:send": "node scripts/send-notifications.js",
    "production:check": "node scripts/production-check.js",
    "backup": "node scripts/backup.js"
  },
  "engines": {
    "node": ">=22 <23"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "dayjs": "^1.11.23",
    "dotenv": "^18.0.4",
    "ejs": "^6.0.1",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.19.0",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "sharp": "^0.35.5"
  }
}
