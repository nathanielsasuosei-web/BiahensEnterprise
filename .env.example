# ---- Biahens Enterprise configuration -------------------------------------
# Copy to `.env` and adjust. Everything has a safe default so the app boots
# with no .env file at all.

PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Public base URL used for emails / webhook callbacks / OG tags.
PUBLIC_URL=http://localhost:3000

# Session signing secret -- CHANGE THIS IN PRODUCTION
SESSION_SECRET=change-me-biahens-enterprise-session-secret

# Owner account that is created on first seed (the ONLY role that can upload products)
OWNER_NAME=Owner
OWNER_EMAIL=owner@biahensenterprise.com
OWNER_PASSWORD=Biahens@2026
OWNER_PHONE=+233 24 000 0000

# ---- Payments (stub gateway, Paystack-compatible) --------------------------
# No keys are required: the built-in stub gateway simulates the whole flow.
# Drop in real keys and flip GATEWAY_MODE=live to talk to Paystack.
GATEWAY_MODE=test
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx
PAYSTACK_WEBHOOK_SECRET=whsec_biahens_local_test_secret
MOMO_PROVIDER=mock

# ---- Database --------------------------------------------------------------
DB_FILE=./data/biahens.sqlite

# ---- Delivery --------------------------------------------------------------
DEFAULT_CURRENCY=GHS
FREE_SHIPPING_THRESHOLD=1500
DEFAULT_SHIPPING_FEE=35
