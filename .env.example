# LOCAL DEMO ONLY. For the real shop use .env.production.example and docs/production.md.
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
STORE_MODE=demo
PUBLIC_URL=http://localhost:3000
SESSION_SECRET=change-me-biahens-enterprise-session-secret
DB_FILE=./data/biahens.sqlite
SEED_ON_BOOT=false

# Published DEMO accounts. Never import these accounts or sample orders into production.
OWNER_NAME=Owner
OWNER_EMAIL=owner@biahensenterprise.com
OWNER_PASSWORD=Biahens@2026
OWNER_PHONE=+233 24 000 0000

# No real provider call is made by the simulator.
PAYMENT_PROVIDER=simulator
GATEWAY_MODE=test
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_PREVIOUS_WEBHOOK_SECRET=
SIMULATOR_WEBHOOK_SECRET=whsec_biahens_local_test_secret

# Use PAYMENT_PROVIDER=paystack, GATEWAY_MODE=test and sk_test_... to test the
# real hosted provider in an isolated DEMO database. Never use live keys here.
DEFAULT_CURRENCY=GHS
FREE_SHIPPING_THRESHOLD=1500
DEFAULT_SHIPPING_FEE=35
# VAT: Admin -> Store settings -> Commerce. Default 1%, after coupons, excluding delivery.

# Sending is OFF in a demo even when keys are present. Only enable deliberately
# for your own authorized recipients; see docs/order-alerts.md.
NOTIFICATIONS_ENABLED=false
RESEND_API_KEY=
MAIL_FROM=
OWNER_NOTIFICATION_EMAIL=
OWNER_NOTIFICATION_WHATSAPP=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ORDER_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_API_VERSION=v23.0
WHATSAPP_OWNER_OPT_IN=false
NOTIFICATION_CRON_SECRET=
