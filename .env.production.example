# Copy to a PRIVATE hosting secret store (or .env.production on your own server).
# This file intentionally cannot start a live shop until real values are supplied.
# Never paste credentials into chat or commit a populated environment file.
NODE_ENV=production
STORE_MODE=live
HOST=0.0.0.0
PORT=3000
PUBLIC_URL=
# Attach the durable disk here. Do not use /tmp or the build filesystem.
DATA_DIR=/var/data
PERSISTENT_STORAGE=true
SEED_ON_BOOT=false
# DB_FILE, UPLOADS_DIR and BACKUP_DIR default to children of DATA_DIR.
SESSION_SECRET=

# Used ONLY when there is no active owner account. A 16+ character unique password.
OWNER_NAME=
OWNER_EMAIL=
OWNER_PHONE=
OWNER_PASSWORD=

PAYMENT_PROVIDER=paystack
GATEWAY_MODE=live
PAYSTACK_SECRET_KEY=
# Optional: hosted checkout does not use a browser/public key.
PAYSTACK_PUBLIC_KEY=
# Modern Paystack-Signature uses whsec_. Legacy x-paystack-signature uses the API key.
PAYSTACK_WEBHOOK_SECRET=
# Optional during a signing-secret rotation only; remove after the overlap period.
PAYSTACK_PREVIOUS_WEBHOOK_SECRET=

NOTIFICATIONS_ENABLED=true
RESEND_API_KEY=
MAIL_FROM=
OWNER_NOTIFICATION_EMAIL=
OWNER_NOTIFICATION_WHATSAPP=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ORDER_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_API_VERSION=v23.0
# Set true only with the owner's permission to send these alerts.
WHATSAPP_OWNER_OPT_IN=false
# Optional for an external scheduler; the Node server already drains every 30s.
NOTIFICATION_CRON_SECRET=
