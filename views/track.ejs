<%- include('partials/head') %>
<%- include('partials/header') %>
<%
  const flow = ['pending_payment', 'paid', 'processing', 'shipped', 'delivered'];
  const sm = order ? (STATUS_META[order.status] || { label: order.status, tone: 'muted' }) : null;
  const curIdx = order ? flow.indexOf(order.status) : -1;
%>
<main class="container" id="main" style="padding:1.2rem 0 2.6rem">
  <nav class="breadcrumbs dark"><a href="/">Home</a><span class="sep">/</span><span class="cur">Track an order</span></nav>

  <div style="max-width:640px;margin:0 auto 2rem">
    <h1 class="center">Track your order</h1>
    <p class="muted center" style="margin:.2rem 0 1.2rem">Enter the order number from your confirmation email together with the phone number or email you checked out with.</p>
    <form action="/track-order" method="post" class="card pad">
      <div class="field">
        <label class="label" for="orderNumber">Order number <span style="color:#D64545">*</span></label>
        <input class="input" id="orderNumber" name="order_number" placeholder="BIA-000123" value="<%= order ? order.order_number : (query.n || '') %>" required>
        <span class="hint">It looks like <b>BIA-</b> followed by six digits.</span>
      </div>
      <div class="field">
        <label class="label" for="contact">Phone number or email used <span style="color:#D64545">*</span></label>
        <input class="input" id="contact" name="contact" placeholder="024 123 4567 or you@example.com" required>
      </div>
      <button class="btn primary lg block" type="submit"><%- icon('search') %> Track my order</button>
    </form>
    <% if (notFound) { %><div class="inline-alert danger" style="margin-top:.8rem"><%= notFound %></div><% } %>
    <% if (user) { %><p class="small muted center" style="margin-top:.9rem">Signed in? All your orders are listed in <a href="/account/orders" style="color:#F26B21;font-weight:800">your account</a>.</p><% } %>
  </div>

  <% if (order) { %>
    <div class="card" style="max-width:900px;margin:0 auto">
      <div class="summary-head row between">
        <span><%- icon('box') %> Order <%= order.order_number %></span>
        <span class="badge <%= sm.tone %>"><%= sm.label %></span>
      </div>
      <div class="summary-body">
        <div class="row between wrap" style="gap:.6rem;margin-bottom:1rem">
          <span class="small muted">Placed <%= dateFmt(order.placed_at, 'D MMMM YYYY [at] h:mm a') %> · <%= order.item_count %> item<%= order.item_count === 1 ? '' : 's' %> · <b style="color:#0B1A27"><%= settings.currency_symbol %> <%= money(order.total) %></b></span>
          <span class="small">
            Payment: <b class="<%= order.payment_status === 'paid' ? '' : 'muted' %>" style="<%= order.payment_status === 'paid' ? 'color:#12805C' : '' %>"><%= order.payment_status.replace(/_/g, ' ') %></b>
          </span>
        </div>

        <% if (curIdx >= 0) { %>
          <div class="order-progress">
            <% flow.forEach(function (s, i) { %>
              <div class="seg <%= i < curIdx ? 'done' : '' %> <%= i === curIdx ? 'current' : '' %>"><%= STATUS_META[s].label %></div>
            <% }); %>
          </div>
        <% } %>

        <div class="grid g-2" style="gap:1rem;margin-top:1rem">
          <div>
            <h3 style="font-size:.95rem;margin-bottom:.5rem"><%- icon('truck') %> Delivery</h3>
            <p class="small muted" style="margin:0">
              <b style="color:#0B1A27"><%= order.ship_name %></b><br>
              <%= order.ship_line %><% if (order.ship_landmark) { %><br>Near <%= order.ship_landmark %><% } %><br>
              <%= order.ship_city %>, <%= order.ship_region %><br>
              <%= order.ship_phone %>
            </p>
            <% if (order.tracking_number) { %>
              <p class="small" style="margin-top:.5rem">Tracking number: <b><%= order.tracking_number %></b><% if (order.carrier) { %> via <%= order.carrier %><% } %></p>
            <% } %>
          </div>
          <div>
            <h3 style="font-size:.95rem;margin-bottom:.5rem"><%- icon('box') %> Items</h3>
            <div class="stack" style="gap:.45rem">
              <% order.items.forEach(function (i) { %>
                <div class="row" style="gap:.5rem">
                  <img src="<%= imgSrc(i.image, { w: 100, h: 100, hint: settings.store_name, name: i.name }) %>" alt="" loading="lazy" style="width:38px;height:38px;border-radius:8px;object-fit:cover">
                  <span class="grow small"><b style="display:block;line-height:1.3"><%= truncate(i.name, 52) %></b><span class="tiny">Qty <%= i.qty %></span></span>
                  <b class="small"><%= settings.currency_symbol %> <%= money(i.total) %></b>
                </div>
              <% }); %>
            </div>
          </div>
        </div>

        <% if (order.events && order.events.length) { %>
          <div class="divider" style="margin:1.1rem 0"></div>
          <h3 style="font-size:.95rem;margin-bottom:.5rem"><%- icon('activity') %> Updates</h3>
          <div class="timeline">
            <% order.events.slice().reverse().forEach(function (e) { %>
              <div class="tl-item">
                <span class="dot"></span>
                <div>
                  <b class="small"><%= STATUS_META[e.status] ? STATUS_META[e.status].label : e.status %></b>
                  <span class="tiny" style="color:#64748B;display:block"><%= dateFmt(e.created_at, 'D MMM YYYY, h:mm a') %></span>
                  <% if (e.note) { %><p class="small" style="margin:.2rem 0 0"><%= e.note %></p><% } %>
                </div>
              </div>
            <% }); %>
          </div>
        <% } %>

        <div class="row" style="gap:.5rem;margin-top:1.2rem;flex-wrap:wrap">
          <a class="btn primary" href="/order/<%= order.order_number %>"><%- icon('receipt') %> Full order details</a>
          <a class="btn ghost" href="/order/<%= order.order_number %>/receipt" target="_blank"><%- icon('printer') %> Print receipt</a>
          <a class="btn ghost" href="https://wa.me/<%= (settings.support_whatsapp || '').replace(/[^0-9]/g,'') %>?text=Hello,%20about%20order%20<%= order.order_number %>" target="_blank" rel="noopener"><%- icon('whatsapp') %> Ask about this order</a>
        </div>
      </div>
    </div>
  <% } %>
</main>
<%- include('partials/footer') %>
