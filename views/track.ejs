<%- include('partials/head') %>
<%- include('partials/header') %>
<main class="container tracking-page" id="main">
  <nav class="breadcrumbs dark" aria-label="Breadcrumb"><a href="/account">My account</a><span class="sep">/</span><span class="cur">Order tracking</span></nav>
  <div class="tracking-heading"><div><span class="eyebrow">YOUR ORDERS. YOUR UPDATES.</span><h1>From our store to your door.</h1><p class="muted">Hi <%= user.name.split(' ')[0] %>, your orders appear here automatically. Only you can see your account’s orders.</p></div><a class="btn ghost" href="/account/orders"><%- icon('package') %> All my orders</a></div>
  <% if (notFound) { %><p class="inline-alert danger" role="alert"><%= notFound %></p><% } %>
  <% if (!myOrders.length) { %>
    <div class="empty-state"><span class="tracking-empty-icon"><%- icon('bag') %></span><h2>Your next good find starts here.</h2><p>You haven’t placed an order yet. When you do, its progress will appear here automatically.</p><a class="btn primary" href="/categories">Explore the store <%- icon('arrow-right') %></a></div>
  <% } else { %>
    <div class="tracking-layout">
      <aside class="tracking-order-list" aria-label="Your orders"><h2>Your orders <span><%= myOrders.length %></span></h2>
        <% myOrders.forEach(function (item) { const meta = STATUS_META[item.status] || { label: item.status }; %><a href="/track-order?order=<%= encodeURIComponent(item.order_number) %>" class="tracking-order-link <%= order && order.id === item.id ? 'active' : '' %>" <%- order && order.id === item.id ? 'aria-current="page"' : '' %>><b><%= item.order_number %></b><span><%= dateFmt(item.placed_at) %> · <%= money(item.total) %></span><small><%= meta.label %></small></a><% }); %>
      </aside>
      <% if (order) { %>
      <section class="tracking-detail" data-order-tracker="<%= order.order_number %>">
        <div class="tracking-status-card"><div class="row between wrap"><span class="eyebrow">ORDER <%= order.order_number %></span><span class="badge <%= tracking.tone %>" data-track-status><%= tracking.label %></span></div><h2>A little closer to you.</h2><p class="muted">Placed <%= dateFmt(order.placed_at) %> · <%= order.item_count %> item<%= order.item_count === 1 ? '' : 's' %> · <%= money(order.total) %></p>
          <div class="order-progress" data-track-progress><% tracking.steps.forEach(function (step) { %><div class="seg <%= step.done ? 'done' : '' %> <%= step.current ? 'current' : '' %>"><%= step.label %></div><% }); %></div>
          <div class="tracking-carrier" data-track-carrier><%- icon('truck') %><span><%= order.tracking_number ? (order.carrier ? order.carrier + ' · ' : '') + order.tracking_number : 'Carrier details will appear once your order is dispatched.' %></span></div>
          <div class="tracking-live-row"><p class="tracking-live" data-track-message role="status">Status checks automatically every 20 seconds.</p><button class="btn ghost sm" type="button" data-track-refresh><%- icon('refresh') %> Refresh</button></div>
        </div>
        <div class="card pad tracking-updates"><h2>Every step, in the loop.</h2><div class="timeline" data-track-events><% tracking.events.forEach(function (event) { %><div class="tl-item"><span class="dot"></span><div><b class="small"><%= event.label %></b><time class="tiny muted"><%= event.date %></time><% if (event.note) { %><p class="small"><%= event.note %></p><% } %></div></div><% }); %></div></div>
        <div class="tracking-actions"><a class="btn primary" href="/account/orders/<%= order.order_number %>">Order details <%- icon('arrow-right') %></a><a class="btn ghost" href="/order/<%= order.order_number %>/receipt" target="_blank" rel="noopener"><%- icon('printer') %> Receipt</a><a class="text-link" href="/contact">Contact support</a></div>
        <p class="small muted tracking-disclaimer">These are fulfilment updates from the store and carrier, not live GPS tracking.</p>
      </section>
      <% } %>
    </div>
  <% } %>
</main>
<%- include('partials/footer') %>
