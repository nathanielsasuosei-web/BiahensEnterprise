<!DOCTYPE html>
<html lang="en-GH">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Temporarily unavailable' %></title>
<meta name="robots" content="noindex">
<link rel="icon" href="/img/favicon.svg">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;700;800;900&display=swap">
<link rel="stylesheet" href="/css/site.css">
</head>
<body style="background:linear-gradient(160deg,#0A1F33,#0F2A43 50%,#1D4E6B);min-height:100vh;display:grid;place-items:center;padding:1.5rem;color:#fff">
  <div style="max-width:560px;text-align:center">
    <div style="width:74px;height:74px;border-radius:20px;background:linear-gradient(135deg,#F26B21,#FFB300);display:grid;place-items:center;font-weight:900;font-size:1.8rem;color:#3A1A00;margin:0 auto 1.4rem">B</div>
    <h1 style="color:#fff;font-size:1.9rem;margin-bottom:.6rem">We are upgrading the store</h1>
    <p style="color:#C7D6E2;margin-bottom:1.6rem"><%= typeof message !== 'undefined' && message ? message : 'Please check back shortly.' %></p>
    <p style="color:#9FB4C6;font-size:.88rem">Need to reach us right now? Call <b style="color:#FFD66B">+233 30 200 4455</b> or WhatsApp <b style="color:#FFD66B">+233 24 700 8899</b>.</p>
    <a class="btn gold lg" href="/admin/login" style="margin-top:1.6rem">Owner sign-in</a>
  </div>
</body>
</html>
