<%- include('../partials/head') %>
<div class="auth-wrap">
  <aside class="auth-side">
    <a href="/" class="row" style="gap:.6rem;margin-bottom:2rem;position:relative;z-index:1">
      <span style="width:42px;height:42px;border-radius:12px;background:linear-gradient(135deg,#F26B21,#FFB300);display:grid;place-items:center;font-weight:900;font-size:1.2rem;color:#3A1A00">B</span>
      <span><b style="color:#fff;font-size:1.05rem;display:block;line-height:1.2"><%= settings.store_name %></b>
      <span style="font-size:.75rem;color:#9FB4C6"><%= settings.tagline || 'Ghana’s trusted online store' %></span></span>
    </a>
    <h2>Welcome back to <%= settings.store_name %></h2>
    <p>Sign in to track your orders, keep your wishlist, check out in seconds and see prices in Ghana cedis with delivery to your doorstep.</p>
    <div class="auth-perks">
      <span class="row"><span class="ico"><%- icon('truck') %></span> Free delivery in Greater Accra above <%= settings.currency_symbol %> <%= Number(settings.free_shipping_threshold).toFixed(0) %></span>
      <span class="row"><span class="ico"><%- icon('wallet') %></span> Pay with MTN MoMo, Telecel Cash, AT Money, card or cash on delivery</span>
      <span class="row"><span class="ico"><%- icon('shield') %></span> <%= settings.warranty_note || 'Warranty on every electronic item' %> · <%= settings.return_days %>-day returns</span>
      <span class="row"><span class="ico"><%- icon('store') %></span> Everything stocked by us — no third-party sellers, no surprises</span>
    </div>
    <div class="pay-badges" style="margin-top:2rem">
      <span class="pay-badge">MTN MoMo</span><span class="pay-badge">TELECEL</span><span class="pay-badge">AT MONEY</span>
      <span class="pay-badge">VISA</span><span class="pay-badge">MASTERCARD</span><span class="pay-badge">CASH ON DELIVERY</span>
    </div>
  </aside>

  <div class="auth-main">
    <div class="auth-card">
      <h1>Sign in</h1>
      <p class="sub">New here? <a href="/register" style="color:#F26B21;font-weight:800">Create a free account</a></p>

      <% if (error) { %>
        <div class="inline-alert danger"><%- icon('alert') %> <%= error %></div>
      <% } %>
      <% if (returnTo) { %>
        <div class="inline-alert">You will be returned to <b><%= returnTo %></b> after signing in.</div>
      <% } %>

      <form action="/login" method="post" novalidate>
        <% if (returnTo) { %><input type="hidden" name="return_to" value="<%= returnTo %>"><% } %>
        <div class="field">
          <label class="label" for="email">Email address</label>
          <input class="input" id="email" name="email" type="email" value="<%= values.email || '' %>" required autocomplete="email" placeholder="you@example.com" autofocus>
        </div>
        <div class="field">
          <label class="label" for="password">Password</label>
          <div class="pw-wrap">
            <input class="input" id="password" name="password" type="password" required autocomplete="current-password" placeholder="••••••••">
            <button type="button" class="pw-toggle" data-toggle-pw="password" aria-label="Show password"><%- icon('eye') %></button>
          </div>
        </div>
        <div class="row between" style="margin-bottom:1rem">
          <label class="checkbox"><input type="checkbox" name="remember" value="1" checked> <span class="small">Keep me signed in</span></label>
          <a class="small" href="/forgot-password" style="color:#F26B21;font-weight:700">Forgot password?</a>
        </div>
        <button class="btn primary lg block" type="submit"><%- icon('login') %> Sign in</button>
      </form>

      <% if (demoHint) { %>
        <div class="inline-alert" style="margin-top:1.1rem">
          <b>Demo accounts</b> (development mode):
          <div class="stack tiny" style="gap:.25rem;margin-top:.4rem">
            <span>Owner — <code>owner@biahensenterprise.com</code> / <code>Biahens@2026</code> · <a href="/admin/login" style="font-weight:800">admin panel</a></span>
            <span>Staff — <code>staff@biahensenterprise.com</code> / <code>Staff@2026</code></span>
            <span>Shopper — any seeded customer email / <code>Customer@2026</code></span>
          </div>
        </div>
      <% } %>

      <div class="auth-alt">
        <a href="/" class="btn ghost sm"><%- icon('arrow-left') %> Back to the store</a>
        <p class="tiny muted" style="margin-top:.9rem">Protected by rate limiting. By signing in you agree to our <a href="/terms">terms</a> and <a href="/privacy">privacy policy</a>.</p>
      </div>
    </div>
  </div>
</div>
<script src="/js/site.js" defer></script>
</body>
</html>
