<!DOCTYPE html>
<html lang="en-GH">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex,nofollow">
<meta name="referrer" content="strict-origin-when-cross-origin">
<title><%= typeof pageTitle !== 'undefined' && pageTitle ? pageTitle : 'Admin · ' + settings.store_name %></title>
<link rel="icon" href="https://i.imgur.com/MQx4nCO.png?fb" type="image/png">
<link rel="preload" href="/fonts/plus-jakarta-sans-latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/css/admin.css?v=1.1">
<% if (typeof extraCss !== 'undefined' && extraCss) { %><link rel="stylesheet" href="<%= extraCss %>"><% } %>
<script>
  window.BIAHENS = {
    currency: <%- JSON.stringify(settings.currency_symbol) %>,
    adminNav: <%- JSON.stringify(typeof adminNav !== 'undefined' ? adminNav : '') %>,
    isOwner: <%- JSON.stringify(isOwner) %>,
    csrfToken: null
  };
</script>
</head>
<body class="<%= typeof bodyClass !== 'undefined' ? bodyClass : 'admin' %>">
<%- include('flash') %>
