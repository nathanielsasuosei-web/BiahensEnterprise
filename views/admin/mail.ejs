<%- include('partials/head') %>
<div class="admin-shell">
  <%- include('partials/sidebar') %>
  <div class="main">
    <%- include('partials/topbar', { pageHeading: 'Order alerts & delivery' }) %>
    <div class="content">
      <div class="page-head"><div><h1>Never miss a new order.</h1><p class="sub">Owner email and WhatsApp alerts, with a saved delivery log. Only the owner can configure this page.</p></div><div class="actions"><button class="btn ghost" type="button" onclick="location.reload()"><%- icon('refresh') %> Refresh log</button><form action="/admin/system/mail/retry" method="post"><button class="btn primary" type="submit"><%- icon('send') %> Retry pending messages</button></form></div></div>
      <% if (cfg.ephemeralFs) { %><div class="inline-alert danger"><b>Demo storage warning:</b> this deployment uses an ephemeral SQLite database. Accounts, orders and queued alerts can disappear on a cold start. Move to persistent storage before taking real orders.</div><% } %>
      <div class="grid g-2" style="gap:1rem;margin-bottom:1rem">
        <% [['email', 'Email · Resend', 'mail'], ['whatsapp', 'WhatsApp Business', 'whatsapp']].forEach(function (channel) { const state = channels[channel[0]]; %>
          <section class="card"><div class="card-head"><h2><%- icon(channel[2]) %> <%= channel[1] %></h2><span class="badge <%= state.ready ? 'success' : 'warn' %>"><%= state.ready ? 'Configured' : 'Setup required' %></span></div><div class="card-body"><p class="small">Owner recipient: <b><%= state.recipient || 'Not set' %></b></p><% if (state.missing.length) { %><p class="small muted">Required: <%= state.missing.join(', ') %>.</p><% } else { %><p class="small muted">New orders will automatically queue an alert on this channel.</p><% } %></div></section>
        <% }); %>
      </div>
      <form class="card" action="/admin/system/mail/verify" method="post" style="margin-bottom:1rem"><div class="card-body"><h2>Verify your connected providers</h2><p class="small muted">This explicitly sends one verification email and one approved-template WhatsApp message to the configured owner recipients. It does not create an order or charge money. Provider acceptance is not delivery confirmation; check both devices.</p><label class="checkbox"><input type="checkbox" name="confirm" value="SEND" required><span>I authorize both verification messages to my configured recipients.</span></label><button class="btn primary" type="submit" style="margin-top:.7rem" <%= channels.email.ready && channels.whatsapp.ready ? '' : 'disabled' %>><%- icon('send') %> Send verification messages</button></div></form>
      <div class="grid g-2-1" style="gap:1rem;align-items:start">
        <div class="stack" style="gap:1rem">
          <form class="card" action="/admin/system/mail/settings" method="post"><div class="card-head"><div><h2>Where should your alerts go?</h2><span class="sub">Leave a field blank to use the owner account’s email or phone. Environment overrides take precedence.</span></div></div><div class="card-body"><div class="form-grid"><div class="field"><label class="label" for="ownerAlertEmail">Owner email</label><input class="input" type="email" name="email" id="ownerAlertEmail" value="<%= preferences.email %>" placeholder="<%= channels.email.recipient %>" autocomplete="email"></div><div class="field"><label class="label" for="ownerAlertWhatsapp">Owner WhatsApp number</label><input class="input" type="tel" name="whatsapp" id="ownerAlertWhatsapp" value="<%= preferences.whatsapp %>" placeholder="+233241234567" autocomplete="tel"></div></div><label class="checkbox"><input type="checkbox" name="opt_in" value="1" <%= preferences.optedIn ? 'checked' : '' %>><span>I own this number and agree to receive automated order alerts through WhatsApp.</span></label></div><div class="card-foot"><button class="btn primary" type="submit"><%- icon('save') %> Save alert preferences</button></div></form>
          <section class="card"><div class="card-head"><div><h2>Delivery log</h2><span class="sub">Latest 100 messages · includes owner alerts and customer emails</span></div></div><div class="card-body">
            <% if (!messages.length) { %><div class="empty"><h3>No messages yet</h3><p>After a customer places an order, an email and a WhatsApp alert will appear here automatically.</p></div><% } %>
            <% messages.forEach(function (message) { const tone = message.status === 'sent' ? 'success' : message.status === 'failed' ? 'danger' : 'warn'; %><details class="card" style="padding:.8rem;margin-bottom:.65rem"><summary style="cursor:pointer"><span class="badge <%= tone %>"><%= message.status === 'sent' ? 'Provider accepted' : message.status.replace('_',' ') %></span> <b class="small"><%= message.subject %></b><span class="tiny muted" style="display:block;margin-top:.4rem"><%= message.channel === 'email' ? 'Email' : 'WhatsApp' %> → <%= message.to || 'Recipient not configured' %> · <%= dateFmt(message.at) %></span></summary><p class="tiny muted">Attempts: <%= message.attempts %><% if (message.provider_id) { %> · Provider ID: <%= message.provider_id %><% } %></p><% if (message.last_error) { %><p class="small" style="color:var(--red)"><%= message.last_error %></p><% } %><pre class="mono" style="white-space:pre-wrap;overflow-wrap:anywhere;font-size:.8rem;margin-top:.6rem"><%= message.text %></pre></details><% }); %>
          </div></section>
        </div>
        <aside class="stack" style="gap:1rem"><section class="card"><div class="card-head"><h2>Connect delivery services</h2></div><div class="card-body small"><p>Set <code>NOTIFICATIONS_ENABLED=true</code> and these private environment variables on the persistent server, then redeploy. Never put keys in a public form or repository.</p><h3 style="font-size:.9rem;margin-top:1rem">Email</h3><p class="muted"><code>RESEND_API_KEY</code><br><code>MAIL_FROM</code> — an address on a verified sending domain.</p><h3 style="font-size:.9rem;margin-top:1rem">WhatsApp</h3><p class="muted"><code>WHATSAPP_ACCESS_TOKEN</code><br><code>WHATSAPP_PHONE_NUMBER_ID</code><br><code>WHATSAPP_ORDER_TEMPLATE</code><br><code>WHATSAPP_TEMPLATE_LANGUAGE</code></p><p class="muted">Use an approved utility template with six body fields, in this order: order number, customer name, item count, total, payment status and admin order URL. The owner must opt in above. A normal WhatsApp chat link cannot send automatic alerts.</p><p class="tiny muted">The complete setup guide and sample template are in <code>docs/order-alerts.md</code>.</p></div></section><section class="card"><div class="card-head"><h2>What the statuses mean</h2></div><div class="card-body small"><p><b>Setup required:</b> saved, but not sent. Connect the services first.</p><p><b>Provider accepted:</b> the provider accepted the request; it does not confirm receipt or reading.</p><p><b>Failed:</b> the error is saved. Temporary failures retry with backoff; use the retry button after fixing configuration.</p><p class="muted">Alerts do not mark an order as paid. Always verify the order’s payment status in the dashboard.</p></div></section></aside>
      </div>
    </div>
  </div>
</div>
<script src="/js/admin.js" defer></script>
</body>
</html>
