<%- include('../partials/head') %>
<div class="admin-shell">
  <%- include('../partials/sidebar') %>
  <div class="main">
    <%- include('../partials/topbar', { pageHeading: 'Newsletter' }) %>
    <div class="content">
      <div class="page-head">
        <div>
          <h1>Newsletter subscribers</h1>
          <p class="sub"><%= total %> shopper<%= total === 1 ? '' : 's' %> have opted in to deals, flash-sale alerts and new arrivals.</p>
        </div>
        <div class="actions">
          <a class="btn ghost" href="/admin/marketing/newsletter/export.csv"><%- icon('download') %> Export CSV</a>
          <a class="btn ghost" href="/admin/marketing/coupons"><%- icon('percent') %> Coupons</a>
        </div>
      </div>

      <div class="grid g-2-1" style="gap:1rem;align-items:start">
        <div class="card">
          <div class="card-head"><div><h2>Subscribers</h2><span class="sub">Newest first</span></div>
            <span class="badge outline"><%= total %> total</span></div>
          <div class="card-body" style="padding:0">
            <div class="table-wrap">
              <table class="table" style="min-width:560px">
                <thead><tr><th>Email address</th><th>Subscribed</th><th>Status</th><th style="text-align:right">Actions</th></tr></thead>
                <tbody>
                  <% if (!subscribers.length) { %>
                    <tr><td colspan="4"><div class="empty"><span class="ico">&#128231;</span><h3>No subscribers yet</h3><p class="muted">The footer newsletter form and the registration page both feed this list.</p></div></td></tr>
                  <% } %>
                  <% subscribers.forEach(function (s) { %>
                    <tr>
                      <td><b><%= s.email %></b></td>
                      <td class="small muted"><%= dateFmt(s.created_at, 'D MMM YYYY, h:mm a') %> · <%= timeAgo(s.created_at) %></td>
                      <td><span class="badge success">Subscribed</span></td>
                      <td>
                        <div class="row-actions">
                          <a class="btn ghost xs" href="mailto:<%= s.email %>" title="Email"><%- icon('mail') %></a>
                          <a class="btn ghost xs" href="/admin/customers?q=<%= encodeURIComponent(s.email) %>" title="Find matching customer"><%- icon('user') %></a>
                          <button class="btn ghost xs" type="button" data-copy="<%= s.email %>" title="Copy"><%- icon('copy') %></button>
                          <form action="/admin/marketing/newsletter/<%= s.id %>/delete" method="post" style="display:inline"
                                onsubmit="return confirm('Remove <%= s.email %> from the newsletter list?')">
                            <button class="btn ghost xs" type="submit" style="color:var(--red)" title="Remove"><%- icon('trash') %></button>
                          </form>
                        </div>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          </div>
          <% if (pager.pages > 1) { %><div class="card-foot"><%- include('../partials/pager', { pager: pager, filters: {} }) %></div><% } %>
        </div>

        <aside class="stack" style="gap:1rem">
          <div class="card">
            <div class="card-head"><div><h2>Campaign ideas</h2><span class="sub">No email service is connected yet</span></div></div>
            <div class="card-body">
              <p class="small muted">This build captures and stores subscribers but does not send bulk email — connect your provider (Mailchimp, Brevo, SendGrid) using the CSV export.</p>
              <div class="stack small" style="gap:.5rem;margin-top:.7rem">
                <span class="row" style="gap:.4rem"><span style="color:var(--green)"><%- icon('check-circle') %></span> Weekly “8am flash sale” reminder</span>
                <span class="row" style="gap:.4rem"><span style="color:var(--green)"><%- icon('check-circle') %></span> Back-in-stock alerts for wishlisted items</span>
                <span class="row" style="gap:.4rem"><span style="color:var(--green)"><%- icon('check-circle') %></span> New arrivals by category</span>
                <span class="row" style="gap:.4rem"><span style="color:var(--green)"><%- icon('check-circle') %></span> Festive campaigns (Christmas, Easter, Eid, Black Friday)</span>
                <span class="row" style="gap:.4rem"><span style="color:var(--green)"><%- icon('check-circle') %></span> Win-back after 60 days of inactivity</span>
              </div>
            </div>
          </div>

          <div class="card">
            <div class="card-head"><div><h2>Where sign-ups come from</h2></div></div>
            <div class="card-body small">
              <div class="stat-line row between"><span class="muted">Footer newsletter form</span><b>/ (all pages)</b></div>
              <div class="stat-line row between"><span class="muted">Registration opt-in</span><b>/register</b></div>
              <div class="stat-line row between"><span class="muted">Public endpoint</span><b>POST /newsletter</b></div>
              <div class="divider"></div>
              <p class="tiny muted" style="margin:0">Every sign-up is deduplicated by email address and stored with a timestamp, ready for a double-opt-in flow when you connect a provider.</p>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </div>
</div>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('[data-copy]').forEach(function (b) {
      b.addEventListener('click', function () {
        if (navigator.clipboard) navigator.clipboard.writeText(b.getAttribute('data-copy'));
        var old = b.innerHTML; b.innerHTML = '✓'; setTimeout(function () { b.innerHTML = old; }, 1200);
      });
    });
  });
</script>
<script src="/js/admin.js" defer></script>
</body>
</html>
