<%- include('partials/head') %>
<%
  const isOrders = metric === 'orders';
  const pts = series.map(function (d) { return { label: d.label, value: isOrders ? d.orders : d.value }; });
  const maxTop = Math.max.apply(null, topProducts.map(function (p) { return Number(p.revenue) || 0; }).concat([1]));
  const maxCat = Math.max.apply(null, byCategory.map(function (c) { return Number(c.revenue) || 0; }).concat([1]));
  const maxRegion = Math.max.apply(null, regions.map(function (r) { return Number(r.revenue) || 0; }).concat([1]));
  const maxHour = Math.max.apply(null, hourly.map(function (h) { return h.orders; }).concat([1]));
  const maxWeekday = Math.max.apply(null, weekdays.map(function (w) { return isOrders ? w.orders : w.revenue; }).concat([1]));
  const totalStatus = statuses.reduce(function (s, x) { return s + x.n; }, 0) || 1;
  const payTotal = payments.reduce(function (s, p) { return s + p.n; }, 0) || 1;
  const methodColor = { card: '#0F2A43', momo: '#FFB300', cod: '#12805C' };
  const methodLabel = { card: 'Card', momo: 'Mobile Money', cod: 'Cash on delivery' };
  const windowTotal = series.reduce(function (s, d) { return s + (isOrders ? d.orders : d.value); }, 0);
  const activeDays = series.filter(function (d) { return (isOrders ? d.orders : d.value) > 0; }).length;
%>
<div class="admin-shell">
  <%- include('partials/sidebar') %>
  <div class="main">
    <%- include('partials/topbar', { pageHeading: 'Analytics' }) %>
    <div class="content">
      <div class="page-head">
        <div>
          <h1>Analytics &amp; reports</h1>
          <p class="sub">Last <b><%= days %> days</b> of paid orders · <%= activeDays %> day<%= activeDays === 1 ? '' : 's' %> with sales · average order <%= settings.currency_symbol %> <%= money(aov) %>.</p>
        </div>
        <div class="actions">
          <a class="btn ghost" href="/admin/analytics/export.csv?days=<%= days %>"><%- icon('download') %> Revenue CSV</a>
          <a class="btn ghost" href="/admin/analytics/products.csv"><%- icon('download') %> Products CSV</a>
          <button class="btn primary" type="button" onclick="window.print()"><%- icon('printer') %> Print report</button>
        </div>
      </div>

      <form class="toolbar" method="get" action="/admin/analytics">
        <div class="row wrap" style="gap:.4rem">
          <span class="tiny muted" style="align-self:center;margin-right:.2rem">Range</span>
          <% [7, 14, 30, 60, 90, 180, 365].forEach(function (d) { %>
            <button class="btn <%= days === d ? 'primary' : 'ghost' %> sm" type="submit" name="days" value="<%= d %>"><%= d %>d</button>
          <% }); %>
        </div>
        <div class="row wrap" style="gap:.4rem">
          <span class="tiny muted" style="align-self:center;margin-right:.2rem">Metric</span>
          <button class="btn <%= !isOrders ? 'primary' : 'ghost' %> sm" type="submit" name="metric" value="revenue" formnovalidate><%- icon('cash') %> Revenue</button>
          <button class="btn <%= isOrders ? 'primary' : 'ghost' %> sm" type="submit" name="metric" value="orders" formnovalidate><%- icon('box') %> Orders</button>
        </div>
        <input type="hidden" name="days" value="<%= days %>">
      </form>

      <div class="kpi-grid">
        <div class="kpi" style="--accent:#12805C">
          <div class="k"><span class="ico"><%- icon('cash') %></span> <%= isOrders ? 'Orders' : 'Revenue' %> · <%= days %>d</div>
          <div class="v"><%= isOrders ? current : settings.currency_symbol + ' ' + money(current) %></div>
          <div class="d"><span class="delta <%= change > 0 ? 'up' : change < 0 ? 'down' : 'flat' %>"><%= change > 0 ? '▲' : change < 0 ? '▼' : '■' %> <%= Math.abs(change) %>%</span> vs previous <%= days %> days (<%= isOrders ? previous : money(previous) %>)</div>
        </div>
        <div class="kpi" style="--accent:#F26B21">
          <div class="k"><span class="ico"><%- icon('chart') %></span> Daily average</div>
          <div class="v"><%= isOrders ? (current / days).toFixed(1) : settings.currency_symbol + ' ' + money(current / days) %></div>
          <div class="d">Across <%= days %> days · best day <%= bestDay.label %> (<%= isOrders ? bestDay.orders : money(bestDay.value) %>)</div>
        </div>
        <div class="kpi" style="--accent:#0F2A43">
          <div class="k"><span class="ico"><%- icon('wallet') %></span> Average order value</div>
          <div class="v"><%= settings.currency_symbol %> <%= money(aov) %></div>
          <div class="d">Lifetime · <%= totals.paidOrders %> paid orders</div>
        </div>
        <div class="kpi" style="--accent:#FFB300">
          <div class="k"><span class="ico"><%- icon('clock') %></span> Outstanding</div>
          <div class="v"><%= settings.currency_symbol %> <%= money(totals.outstanding) %></div>
          <div class="d"><%= totals.outstandingOrders %> order<%= totals.outstandingOrders === 1 ? '' : 's' %> awaiting payment</div>
        </div>
      </div>

      <div class="grid g-2-1" style="gap:1rem;align-items:start">
        <div class="card">
          <div class="card-head">
            <div><h2><%= isOrders ? 'Orders' : 'Revenue' %> · last <%= days %> days</h2>
              <span class="sub">Paid orders only — cancelled and refunded orders are excluded</span></div>
            <span class="badge outline"><%= isOrders ? current + ' orders' : settings.currency_symbol + ' ' + moneyShort(current) %></span>
          </div>
          <div class="card-body">
            <%- include('partials/chart', { points: pts, opts: { height: 250, id: 'mainSeries', prefix: isOrders ? '' : settings.currency_symbol, bars: days > 60 } }) %>
            <div class="legend" style="margin-top:.5rem">
              <span><i style="background:<%= isOrders ? '#1D4E6B' : '#F26B21' %>"></i> Daily <%= isOrders ? 'order count' : 'revenue' %></span>
              <span>Total <b><%= isOrders ? current : settings.currency_symbol + ' ' + money(current) %></b></span>
              <span>Peak <b><%= bestDay.label %></b></span>
            </div>
          </div>
          <div class="card-foot">
            <span class="tiny muted">Hover any point for the exact figure. Export the same series as CSV with the button above.</span>
          </div>
        </div>

        <div class="card">
          <div class="card-head"><div><h2>Customer growth</h2><span class="sub">Registered accounts over time</span></div></div>
          <div class="card-body">
            <%- include('partials/chart', { points: growth.map(function (g) { return { label: g.label, value: g.value }; }), opts: { height: 140, id: 'growthChart', color: '#12805C' } }) %>
            <div class="divider"></div>
            <div class="stat-line row between"><span class="muted">Total customers</span><b><%= totals.customers %></b></div>
            <div class="stat-line row between"><span class="muted">New in range</span><b><%= growth.reduce(function (s, g) { return s + g.added; }, 0) %></b></div>
            <div class="stat-line row between"><span class="muted">Live products</span><b><%= totals.products %></b></div>
            <div class="stat-line row between"><span class="muted">Units in stock</span><b><%= totals.units %></b></div>
            <div class="stat-line row between"><span class="muted">Low / out of stock</span><b style="color:var(--red)"><%= totals.lowStock %> / <%= totals.outOfStock %></b></div>
          </div>
        </div>
      </div>

      <div class="grid g-2" style="gap:1rem;margin-top:1rem">
        <div class="card">
          <div class="card-head"><div><h2>Orders by hour of day</h2><span class="sub">All time · local server time</span></div></div>
          <div class="card-body">
            <div class="hourbars">
              <% hourly.forEach(function (h) { %>
                <div class="hourbar" title="<%= String(h.hour).padStart(2, '0') %>:00 — <%= h.orders %> orders">
                  <span class="bar" style="height:<%= Math.max(3, Math.round(h.orders / maxHour * 100)) %>%"></span>
                  <span class="lbl"><%= h.hour % 3 === 0 ? String(h.hour).padStart(2, '0') : '' %></span>
                </div>
              <% }); %>
            </div>
            <% const peak = hourly.reduce(function (b, h) { return h.orders > b.orders ? h : b; }, hourly[0]); %>
            <p class="tiny muted" style="margin:.8rem 0 0">Peak traffic at <b><%= String(peak.hour).padStart(2, '0') %>:00</b> with <%= peak.orders %> orders — schedule flash-sale emails and restocks around this window.</p>
          </div>
        </div>

        <div class="card">
          <div class="card-head"><div><h2>Orders by weekday</h2><span class="sub">All time</span></div></div>
          <div class="card-body">
            <div class="hbar">
              <% weekdays.forEach(function (w) { %>
                <div class="hbar-row">
                  <span style="font-weight:700;width:74px"><%= w.name.slice(0, 3) %></span>
                  <span class="track"><i style="width:<%= Math.max(2, Math.round((isOrders ? w.orders : w.revenue) / maxWeekday * 100)) %>%"></i></span>
                  <span class="v"><%= isOrders ? w.orders : moneyShort(w.revenue) %></span>
                </div>
              <% }); %>
            </div>
            <% const best = weekdays.reduce(function (b, w) { return (isOrders ? w.orders : w.revenue) > (isOrders ? b.orders : b.revenue) ? w : b; }, weekdays[0]); %>
            <p class="tiny muted" style="margin:.8rem 0 0">Strongest day: <b><%= best.name %></b> — <%= best.orders %> orders worth <%= settings.currency_symbol %> <%= money(best.revenue) %>.</p>
          </div>
        </div>
      </div>

      <div class="grid g-3" style="gap:1rem;margin-top:1rem">
        <div class="card">
          <div class="card-head"><div><h2>Order status mix</h2><span class="sub">All time</span></div></div>
          <div class="card-body">
            <div class="hbar">
              <% statuses.forEach(function (s) { const sm = STATUS_META[s.status] || { label: s.status }; %>
                <div class="hbar-row">
                  <a href="/admin/orders?status=<%= s.status %>" style="font-weight:700;width:104px"><%= sm.label %></a>
                  <span class="track"><i style="width:<%= Math.max(2, Math.round(s.n / totalStatus * 100)) %>%"></i></span>
                  <span class="v"><%= s.n %></span>
                </div>
              <% }); %>
            </div>
            <div class="divider"></div>
            <div class="stat-line row between"><span class="muted">Fulfilment backlog</span><b><%= totals.pendingFulfil %> paid/processing</b></div>
            <div class="stat-line row between"><span class="muted">Cancelled + refunded value</span>
              <b><%= settings.currency_symbol %> <%= money(statuses.filter(function (s) { return s.status === 'cancelled' || s.status === 'refunded'; }).reduce(function (a, s) { return a + s.value; }, 0)) %></b></div>
          </div>
        </div>

        <div class="card">
          <div class="card-head"><div><h2>Payment methods</h2><span class="sub">Share of orders</span></div></div>
          <div class="card-body">
            <div class="donut-wrap">
              <svg width="130" height="130" viewBox="0 0 42 42" aria-label="Payment method mix">
                <circle cx="21" cy="21" r="15.9" fill="none" stroke="#EDF1F6" stroke-width="6"></circle>
                <% let acc = 0; payments.forEach(function (p) { const pct = p.n / payTotal * 100; %>
                  <circle cx="21" cy="21" r="15.9" fill="none" stroke="<%= methodColor[p.method] || '#F26B21' %>" stroke-width="6"
                    stroke-dasharray="<%= pct.toFixed(2) %> <%= (100 - pct).toFixed(2) %>" stroke-dashoffset="<%= (25 - acc).toFixed(2) %>"></circle>
                <% acc += pct; }); %>
                <text x="21" y="20" text-anchor="middle" style="font:800 7px var(--sans);fill:#0F2A43"><%= payTotal %></text>
                <text x="21" y="26" text-anchor="middle" style="font:600 3.2px var(--sans);fill:#64748B">ORDERS</text>
              </svg>
              <div class="donut-legend">
                <% payments.forEach(function (p) { %>
                  <div class="row"><i style="background:<%= methodColor[p.method] || '#F26B21' %>"></i>
                    <span><%= methodLabel[p.method] || p.method %></span>
                    <span class="v"><%= Math.round(p.n / payTotal * 100) %>% · <%= moneyShort(p.value) %></span>
                  </div>
                <% }); %>
                <% if (!payments.length) { %><p class="tiny muted">No payments recorded yet.</p><% } %>
              </div>
            </div>
          </div>
        </div>

        <div class="card">
          <div class="card-head"><div><h2>Revenue by region</h2><span class="sub">Top <%= regions.length %> delivery regions</span></div></div>
          <div class="card-body">
            <div class="hbar">
              <% regions.forEach(function (r) { %>
                <div class="hbar-row">
                  <span style="font-weight:700;width:104px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis"><%= r.region || '—' %></span>
                  <span class="track"><i style="width:<%= Math.max(2, Math.round((Number(r.revenue) || 0) / maxRegion * 100)) %>%;background:#1D4E6B"></i></span>
                  <span class="v"><%= moneyShort(r.revenue) %></span>
                </div>
              <% }); %>
              <% if (!regions.length) { %><p class="tiny muted">No regional data yet.</p><% } %>
            </div>
          </div>
        </div>
      </div>

      <div class="grid g-2" style="gap:1rem;margin-top:1rem">
        <div class="card">
          <div class="card-head">
            <div><h2>Top products · <%= days %> days</h2><span class="sub">By revenue</span></div>
            <a class="btn ghost sm" href="/admin/analytics/products.csv"><%- icon('download') %> CSV</a>
          </div>
          <div class="card-body" style="padding:0">
            <div class="table-wrap">
              <table class="table" style="min-width:640px">
                <thead><tr><th style="width:34px">#</th><th>Product</th><th class="num">Units</th><th class="num">Revenue</th><th style="width:34%">Share</th><th class="num">Stock</th><th class="num">Views</th></tr></thead>
                <tbody>
                  <% if (!topProducts.length) { %>
                    <tr><td colspan="7"><div class="empty"><span class="ico">&#128202;</span><h3>No sales in this range</h3><p class="muted">Widen the date range above.</p></div></td></tr>
                  <% } %>
                  <% topProducts.forEach(function (p, i) { %>
                    <tr>
                      <td class="muted"><%= i + 1 %></td>
                      <td><div class="prod">
                        <img class="thumb" src="<%= imgSrc(p.image, { w: 120, h: 120, hint: 'product', name: p.name }) %>" alt="" loading="lazy">
                        <span><b><a href="/p/<%= p.slug %>" target="_blank"><%= truncate(p.name, 44) %></a></b><span class="muted"><%= settings.currency_symbol %> <%= money(p.price) %></span></span>
                      </div></td>
                      <td class="num strong"><%= p.units %></td>
                      <td class="num strong"><%= settings.currency_symbol %> <%= money(p.revenue) %></td>
                      <td><span class="track" style="display:block;height:8px;background:#EEF2F6;border-radius:99px;overflow:hidden">
                        <i style="display:block;height:100%;width:<%= Math.max(2, Math.round((Number(p.revenue) || 0) / maxTop * 100)) %>%"></i></span></td>
                      <td class="num"><span class="stock-pill <%= p.stock <= 0 ? 'out' : p.stock <= 5 ? 'low' : 'in' %>"><%= p.stock %></span></td>
                      <td class="num muted"><%= p.views_count || 0 %></td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <div class="card">
          <div class="card-head"><div><h2>Revenue by category</h2><span class="sub">All time · top 12</span></div></div>
          <div class="card-body">
            <div class="hbar">
              <% byCategory.forEach(function (c) { %>
                <div class="hbar-row">
                  <a href="/c/<%= c.slug %>" target="_blank" style="font-weight:700;width:132px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis"><%= c.name || 'Other' %></a>
                  <span class="track"><i style="width:<%= Math.max(2, Math.round((Number(c.revenue) || 0) / maxCat * 100)) %>%"></i></span>
                  <span class="v"><%= moneyShort(c.revenue) %></span>
                </div>
              <% }); %>
              <% if (!byCategory.length) { %><p class="tiny muted">No category sales yet.</p><% } %>
            </div>
            <div class="divider"></div>
            <p class="tiny muted" style="margin:0">Categories carrying the most revenue deserve the deepest catalogue, the best photography and the most aggressive promotions.</p>
          </div>
        </div>
      </div>

      <div class="card" style="margin-top:1rem">
        <div class="card-head"><div><h2>Category performance</h2><span class="sub">Units sold, live products, stock depth and average rating per sub-category</span></div></div>
        <div class="card-body" style="padding:0">
          <div class="table-wrap">
            <table class="table" style="min-width:720px">
              <thead><tr><th>Category</th><th class="num">Live products</th><th class="num">Units sold</th><th class="num">Stock on hand</th><th class="num">Avg rating</th><th>Health</th></tr></thead>
              <tbody>
                <% if (!categorySales.length) { %>
                  <tr><td colspan="6"><div class="empty"><span class="ico">&#128193;</span><h3>No category data</h3><p class="muted">Publish products into sub-categories to populate this report.</p></div></td></tr>
                <% } %>
                <% categorySales.forEach(function (c) { %>
                  <tr>
                    <td><b><%= c.name %></b></td>
                    <td class="num"><%= c.products %></td>
                    <td class="num strong"><%= c.units %></td>
                    <td class="num"><%= c.stock %></td>
                    <td class="num"><%= c.rating > 0 ? c.rating + ' ★' : '—' %></td>
                    <td>
                      <% if (!c.products) { %><span class="badge muted">Empty</span>
                      <% } else if (c.units === 0) { %><span class="badge warn">No sales</span>
                      <% } else if (c.stock <= c.products * 2) { %><span class="badge danger">Restock</span>
                      <% } else { %><span class="badge success">Healthy</span><% } %>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        </div>
        <div class="card-foot">
          <span class="tiny muted">Report generated <%= dateFmt(new Date().toISOString(), 'D MMM YYYY, h:mm a') %> · <%= settings.store_name %> · range <%= days %> days · metric <%= metric %>.</span>
        </div>
      </div>
    </div>
  </div>
</div>
<script src="/js/admin.js" defer></script>
</body>
</html>
