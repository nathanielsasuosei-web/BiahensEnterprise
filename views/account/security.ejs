<%- include('../partials/head') %>
<%- include('../partials/header') %>
<main class="container" id="main" style="padding:1.2rem 0 2.6rem">
  <nav class="breadcrumbs dark"><a href="/">Home</a><span class="sep">/</span><a href="/account">Account</a><span class="sep">/</span><span class="cur">Security</span></nav>

  <div class="account-layout">
    <%- include('../partials/account-nav') %>
    <div>
      <h1 style="margin-bottom:1rem">Password &amp; security</h1>

      <% if (error) { %><div class="inline-alert danger"><%- icon('alert') %> <%= error %></div><% } %>
      <% if (success) { %><div class="inline-alert success"><%- icon('check-circle') %> <%= success %></div><% } %>

      <form action="/account/security/password" method="post" class="card">
        <div class="summary-head"><span><%- icon('key') %> Change your password</span></div>
        <div class="summary-body">
          <div class="field">
            <label class="label" for="curPw">Current password <span style="color:#D64545">*</span></label>
            <div class="pw-wrap">
              <input class="input" id="curPw" name="current_password" type="password" required autocomplete="current-password">
              <button type="button" class="pw-toggle" data-toggle-pw="curPw" aria-label="Show password"><%- icon('eye') %></button>
            </div>
          </div>
          <div class="form-grid">
            <div class="field">
              <label class="label" for="password">New password <span style="color:#D64545">*</span></label>
              <div class="pw-wrap">
                <input class="input" id="password" name="new_password" type="password" required minlength="8" autocomplete="new-password">
                <button type="button" class="pw-toggle" data-toggle-pw="password" aria-label="Show password"><%- icon('eye') %></button>
              </div>
              <div class="pw-meter" id="pwMeter"><i style="width:0"></i></div>
              <span class="hint" id="pwLabel">At least 8 characters, one capital letter and one number.</span>
            </div>
            <div class="field">
              <label class="label" for="confirmPw">Confirm new password <span style="color:#D64545">*</span></label>
              <div class="pw-wrap">
                <input class="input" id="confirmPw" name="confirm_password" type="password" required minlength="8" autocomplete="new-password">
                <button type="button" class="pw-toggle" data-toggle-pw="confirmPw" aria-label="Show password"><%- icon('eye') %></button>
              </div>
            </div>
          </div>
          <div class="secure-note"><%- icon('shield') %><span>Changing your password signs you out of every other device. If you did not make this change, contact us immediately on <%= settings.support_phone %>.</span></div>
        </div>
        <div class="card-foot" style="justify-content:flex-end">
          <button class="btn primary" type="submit"><%- icon('save') %> Update password</button>
        </div>
      </form>

      <div class="grid g-2" style="gap:1rem;margin-top:1.1rem">
        <div class="card pad">
          <h3 style="font-size:.95rem;margin-bottom:.5rem"><%- icon('user') %> Account details</h3>
          <p class="small muted" style="margin:0 0 .6rem">
            Signed in as <b style="color:#0B1A27"><%= user.email %></b><br>
            Role: <b style="color:#0B1A27"><%= user.role %></b><br>
            <% if (user.last_login_at) { %>Last login: <%= dateFmt(user.last_login_at, 'D MMM YYYY, h:mm a') %><br><% } %>
            Member since: <%= dateFmt(user.created_at, 'D MMMM YYYY') %>
          </p>
          <a class="btn ghost sm" href="/account/profile"><%- icon('edit') %> Edit profile</a>
        </div>
        <div class="card pad">
          <h3 style="font-size:.95rem;margin-bottom:.5rem"><%- icon('mail') %> Email preferences</h3>
          <p class="small muted" style="margin:0 0 .6rem">You receive order confirmations, dispatch notices and delivery updates by email and SMS. Marketing emails are opt-in only.</p>
          <form action="/newsletter" method="post" style="display:inline">
            <input type="hidden" name="email" value="<%= user.email %>">
            <input type="hidden" name="redirect" value="/account/security">
            <button class="btn ghost sm" type="submit"><%- icon('bell') %> Subscribe to deals</button>
          </form>
        </div>
      </div>
    </div>
  </div>
</main>
<%- include('../partials/footer') %>
