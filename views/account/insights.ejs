<%- include('../partials/head') %>
<%- include('../partials/header') %>
<%
  const maxCat = byCat.length ? Math.max.apply(null, byCat.map(function (c) { return Number(c.revenue) || 0; })) : 1;
%>
<main class="container" id="main" style="padding:1.2rem 0 2.6rem">
  <nav class="breadcrumbs dark"><a href="/">Home</a><span class="sep">/</span><a href="/account">Account</a><span class="sep">/</span><span class="cur">Spending insights</span></nav>

  <div class="account-layout">
    <%- include('../partials/account-nav') %>
    <div>
      <h1 style="margin-bottom:.2rem">Your spending at a glance</h1>
      <p class="muted" style="margin-bottom:1.2rem">A private summary of what you have bought from <%= settings.store_name %>. Only you can see this.</p>

      <div class="grid g-3" style="gap:.9rem;margin-bottom:1.2rem">
        <div class="card pad stat">
          <span class="tiny">Paid orders</span>
          <b style="font-size:1.8rem;display:block"><%= myTotals.orders || 0 %></b>
          <span class="small muted">All time</span>
        </div>
        <div class="card pad stat">
          <span class="tiny">Total spent</span>
          <b style="font-size:1.8rem;display:block"><%= settings.currency_symbol %> <%= money(myTotals.spent || 0) %></b>
          <span class="small muted">Excluding cancellations</span>
        </div>
        <div class="card pad stat">
          <span class="tiny">Average order</span>
          <b style="font-size:1.8rem;display:block"><%= settings.currency_symbol %> <%= money(myTotals.aov || 0) %></b>
          <span class="small muted">Per paid order</span>
        </div>
      </div>

      <div class="grid g-2" style="gap:1rem">
        <div class="card pad">
          <h3 style="font-size:.95rem;margin-bottom:.9rem"><%- icon('chart') %> Where your money goes</h3>
          <% if (!byCat.length) { %>
            <p class="muted small">No paid orders yet — your category breakdown will appear here after your first delivery.</p>
          <% } else { %>
            <div class="stack" style="gap:.7rem">
              <% byCat.forEach(function (c) { %>
                <div>
                  <div class="row between small" style="margin-bottom:.25rem">
                    <b><%= c.name || 'Other' %></b>
                    <span class="muted"><%= settings.currency_symbol %> <%= money(c.revenue) %> · <%= c.units %> unit<%= c.units === 1 ? '' : 's' %></span>
                  </div>
                  <div class="ship-progress" style="padding:0;background:none;border:0"><div class="bar" style="height:8px"><i style="width:<%= Math.max(3, Math.round((Number(c.revenue) || 0) / maxCat * 100)) %>%"></i></div></div>
                </div>
              <% }); %>
            </div>
          <% } %>
        </div>

        <div class="card pad">
          <h3 style="font-size:.95rem;margin-bottom:.9rem"><%- icon('calendar') %> Store activity — last 30 days</h3>
          <p class="tiny" style="margin-bottom:.7rem">Orders placed across <%= settings.store_name %> (all customers), so you can see how busy we are.</p>
          <div class="spark" style="height:70px">
            <% const maxS = Math.max.apply(null, series.map(function (d) { return d.orders || 0; }).concat([1])); %>
            <% series.forEach(function (d) { %>
              <span title="<%= d.date %>: <%= d.orders %> orders, <%= settings.currency_symbol %> <%= money(d.revenue || 0) %>"
                    style="display:block;flex:1;background:linear-gradient(180deg,#F26B21,#FFB300);border-radius:2px 2px 0 0;height:<%= Math.max(4, Math.round((d.orders || 0) / maxS * 100)) %>%"></span>
            <% }); %>
          </div>
          <div class="row between tiny" style="margin-top:.4rem">
            <span><%= series.length ? dateFmt(series[0].date, 'D MMM') : '' %></span>
            <span><%= series.length ? dateFmt(series[series.length - 1].date, 'D MMM') : '' %></span>
          </div>
        </div>
      </div>

      <div class="card pad" style="margin-top:1.1rem">
        <h3 style="font-size:.95rem;margin-bottom:.6rem"><%- icon('gift') %> Your loyalty</h3>
        <p class="small muted" style="margin:0 0 .8rem">Every paid order counts towards priority dispatch and early access to flash sales. Keep your phone number current so our riders can reach you.</p>
        <div class="row wrap" style="gap:.4rem">
          <span class="badge <%= (myTotals.orders || 0) >= 5 ? 'gold' : 'outline' %>"><%= (myTotals.orders || 0) >= 5 ? '★ Repeat customer' : '☆ ' + (5 - (myTotals.orders || 0)) + ' more orders to repeat-customer status' %></span>
          <span class="badge outline">Free delivery above <%= settings.currency_symbol %> <%= Number(settings.free_shipping_threshold).toFixed(0) %></span>
          <a class="btn ghost sm" href="/account/orders"><%- icon('box') %> View order history</a>
        </div>
      </div>
    </div>
  </div>
</main>
<%- include('../partials/footer') %>
