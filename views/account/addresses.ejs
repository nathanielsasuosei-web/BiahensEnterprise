<%- include('../partials/head') %>
<%- include('../partials/header') %>
<main class="container" id="main" style="padding:1.2rem 0 2.6rem">
  <nav class="breadcrumbs dark"><a href="/">Home</a><span class="sep">/</span><a href="/account">Account</a><span class="sep">/</span><span class="cur">Addresses</span></nav>

  <div class="account-layout">
    <%- include('../partials/account-nav') %>
    <div>
      <div class="row between wrap" style="gap:.6rem;margin-bottom:1rem">
        <div>
          <h1 style="margin:0">Delivery addresses</h1>
          <p class="muted" style="margin:.2rem 0 0">Save the places you order to most. Your default address is pre-filled at checkout.</p>
        </div>
        <button class="btn primary" type="button" onclick="document.getElementById('addrForm').scrollIntoView({behavior:'smooth'});document.getElementById('aReceiver').focus()">
          <%- icon('plus') %> Add address
        </button>
      </div>

      <% if (!addresses.length) { %>
        <div class="empty-state card">
          <div class="ico">&#128205;</div>
          <h3>No saved addresses yet</h3>
          <p>Add your home, work or a trusted neighbour’s address and checkout will fill itself in.</p>
        </div>
      <% } else { %>
        <div class="grid g-2" style="gap:.9rem;margin-bottom:1.4rem">
          <% addresses.forEach(function (a) { %>
            <div class="card pad" style="<%= a.is_default ? 'border:2px solid #F26B21;background:#FFF9F5' : '' %>">
              <div class="row between" style="margin-bottom:.4rem">
                <b style="font-size:.92rem"><%= a.label %></b>
                <% if (a.is_default) { %><span class="badge brand">Default</span><% } %>
              </div>
              <p class="small muted" style="margin:0 0 .7rem">
                <b style="color:#0B1A27"><%= a.receiver %></b><br>
                <%= a.line %><% if (a.landmark) { %><br>Near: <%= a.landmark %><% } %><br>
                <%= a.city %>, <%= a.region %><br>
                <%= a.phone %>
              </p>
              <div class="row" style="gap:.4rem;flex-wrap:wrap">
                <% if (!a.is_default) { %>
                  <form action="/account/addresses/<%= a.id %>/default" method="post" style="display:inline">
                    <button class="btn ghost xs" type="submit"><%- icon('check') %> Make default</button>
                  </form>
                <% } %>
                <a class="btn ghost xs" href="/checkout?address=<%= a.id %>"><%- icon('truck') %> Use at checkout</a>
                <form action="/account/addresses/<%= a.id %>/delete" method="post" style="display:inline" onsubmit="return confirm('Delete this address?')">
                  <button class="btn ghost xs" type="submit" style="color:#D64545"><%- icon('trash') %> Delete</button>
                </form>
              </div>
            </div>
          <% }); %>
        </div>
      <% } %>

      <form action="/account/addresses" method="post" class="card" id="addrForm">
        <div class="summary-head"><span><%- icon('plus') %> Add a new address</span></div>
        <div class="summary-body">
          <div class="form-grid">
            <div class="field">
              <label class="label" for="aLabel">Label</label>
              <select class="select" id="aLabel" name="label">
                <% ['Home', 'Work', 'Office', 'Family', 'Other'].forEach(function (l) { %>
                  <option <%= (values.label || 'Home') === l ? 'selected' : '' %>><%= l %></option>
                <% }); %>
              </select>
            </div>
            <div class="field">
              <label class="label" for="aReceiver">Receiver’s full name <span style="color:#D64545">*</span></label>
              <input class="input <%= errors.receiver ? 'err' : '' %>" id="aReceiver" name="receiver" value="<%= values.receiver || user.name || '' %>" required>
              <% if (errors.receiver) { %><span class="error-text"><%= errors.receiver %></span><% } %>
            </div>
          </div>
          <div class="form-grid">
            <div class="field">
              <label class="label" for="aPhone">Phone number <span style="color:#D64545">*</span></label>
              <input class="input <%= errors.phone ? 'err' : '' %>" id="aPhone" name="phone" value="<%= values.phone || user.phone || '' %>" required placeholder="0241234567" inputmode="tel">
              <% if (errors.phone) { %><span class="error-text"><%= errors.phone %></span><% } %>
            </div>
            <div class="field">
              <label class="label" for="aRegion">Region <span style="color:#D64545">*</span></label>
              <select class="select <%= errors.region ? 'err' : '' %>" id="aRegion" name="region" required>
                <option value="">Choose region…</option>
                <% regions.forEach(function (r) { %>
                  <option value="<%= r %>" <%= values.region === r ? 'selected' : '' %>><%= r %></option>
                <% }); %>
              </select>
              <% if (errors.region) { %><span class="error-text"><%= errors.region %></span><% } %>
            </div>
          </div>
          <div class="field">
            <label class="label" for="aCity">Town / city / suburb <span style="color:#D64545">*</span></label>
            <input class="input <%= errors.city ? 'err' : '' %>" id="aCity" name="city" value="<%= values.city || '' %>" required placeholder="e.g. East Legon, Accra">
            <% if (errors.city) { %><span class="error-text"><%= errors.city %></span><% } %>
          </div>
          <div class="field">
            <label class="label" for="aLine">House / street description <span style="color:#D64545">*</span></label>
            <input class="input <%= errors.line ? 'err' : '' %>" id="aLine" name="line" value="<%= values.line || '' %>" required placeholder="Hse No. B12/4, Spintex Road">
            <% if (errors.line) { %><span class="error-text"><%= errors.line %></span><% } %>
          </div>
          <div class="field">
            <label class="label" for="aLandmark">Nearest landmark <span class="muted">(optional)</span></label>
            <input class="input" id="aLandmark" name="landmark" value="<%= values.landmark || '' %>" placeholder="Behind the Total filling station">
          </div>
        </div>
        <div class="card-foot" style="justify-content:flex-end">
          <button class="btn primary" type="submit"><%- icon('save') %> Save address</button>
        </div>
      </form>
    </div>
  </div>
</main>
<%- include('../partials/footer') %>
