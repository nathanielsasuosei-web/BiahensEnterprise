<%- include('../partials/head') %>
<%- include('../partials/header') %>
<main class="container" id="main" style="padding:1.2rem 0 2.6rem">
  <nav class="breadcrumbs dark"><a href="/">Home</a><span class="sep">/</span><a href="/account">Account</a><span class="sep">/</span><span class="cur">Profile</span></nav>

  <div class="account-layout">
    <%- include('../partials/account-nav') %>
    <div>
      <h1 style="margin-bottom:1rem">My profile</h1>
      <form action="/account/profile" method="post" class="card">
        <div class="summary-head"><span><%- icon('user') %> Personal details</span></div>
        <div class="summary-body">
          <div class="row" style="gap:1rem;margin-bottom:1.2rem;align-items:center">
            <div class="avatar" style="width:64px;height:64px;font-size:1.4rem"><%= initials(values.name) %></div>
            <div>
              <b style="display:block"><%= values.name %></b>
              <span class="small muted">Joined <%= dateFmt(values.created_at || user.created_at, 'MMMM YYYY') %><% if (values.last_login_at) { %> · last signed in <%= timeAgo(values.last_login_at) %><% } %></span>
              <% if (lifetime && lifetime.orders) { %>
                <div class="small" style="margin-top:.3rem">
                  <span class="badge success"><%= lifetime.orders %> paid order<%= lifetime.orders === 1 ? '' : 's' %></span>
                  <span class="badge outline"><%= settings.currency_symbol %> <%= money(lifetime.spent || 0) %> spent</span>
                </div>
              <% } %>
            </div>
          </div>

          <div class="form-grid">
            <div class="field">
              <label class="label" for="fName">Full name <span style="color:#D64545">*</span></label>
              <input class="input <%= errors.name ? 'err' : '' %>" id="fName" name="name" value="<%= values.name || '' %>" required>
              <% if (errors.name) { %><span class="error-text"><%= errors.name %></span><% } %>
            </div>
            <div class="field">
              <label class="label" for="fPhone">Phone number</label>
              <input class="input <%= errors.phone ? 'err' : '' %>" id="fPhone" name="phone" value="<%= values.phone || '' %>" placeholder="0241234567" inputmode="tel">
              <span class="hint">Used for delivery calls and Mobile Money receipts.</span>
              <% if (errors.phone) { %><span class="error-text"><%= errors.phone %></span><% } %>
            </div>
          </div>
          <div class="field">
            <label class="label" for="fEmail">Email address <span style="color:#D64545">*</span></label>
            <input class="input <%= errors.email ? 'err' : '' %>" id="fEmail" name="email" type="email" value="<%= values.email || '' %>" required>
            <% if (errors.email) { %><span class="error-text"><%= errors.email %></span><% } else { %>
              <span class="hint">Changing this also changes how you sign in.</span>
            <% } %>
          </div>
        </div>
        <div class="card-foot" style="justify-content:flex-end">
          <button class="btn primary" type="submit"><%- icon('save') %> Save changes</button>
        </div>
      </form>

      <div class="grid g-2" style="gap:1rem;margin-top:1.1rem">
        <div class="card pad">
          <h3 style="font-size:.95rem;margin-bottom:.5rem"><%- icon('shield') %> Password</h3>
          <p class="small muted" style="margin-bottom:.8rem">Use at least 8 characters with a capital letter and a number.</p>
          <a class="btn ghost sm" href="/account/security"><%- icon('key') %> Change password</a>
        </div>
        <div class="card pad">
          <h3 style="font-size:.95rem;margin-bottom:.5rem"><%- icon('pin') %> Delivery addresses</h3>
          <p class="small muted" style="margin-bottom:.8rem">Save the places you order to most so checkout is one tap.</p>
          <a class="btn ghost sm" href="/account/addresses"><%- icon('pin') %> Manage addresses</a>
        </div>
      </div>
    </div>
  </div>
</main>
<%- include('../partials/footer') %>
