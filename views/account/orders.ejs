<%- include('../partials/head') %>
<%- include('../partials/header') %>
<%
  const tabs = [['all', 'All orders'], ['pending_payment', 'Awaiting payment'], ['paid', 'Paid'], ['processing', 'Processing'], ['shipped', 'Shipped'], ['delivered', 'Delivered'], ['cancelled', 'Cancelled'], ['refunded', 'Refunded']];
%>
<main class="container" id="main" style="padding:1.2rem 0 2.6rem">
  <nav class="breadcrumbs dark"><a href="/">Home</a><span class="sep">/</span><a href="/account">Account</a><span class="sep">/</span><span class="cur">My orders</span></nav>
  <h1 style="margin-bottom:1.1rem">My orders</h1>

  <div class="account-layout">
    <%- include('../partials/account-nav') %>
    <div>
      <div class="row wrap" style="gap:.4rem;margin-bottom:1rem">
        <% tabs.forEach(function (t) { %>
          <a class="chip <%= status === t[0] ? 'on' : '' %>" href="/account/orders?status=<%= t[0] %>">
            <%= t[1] %><% if (t[0] === 'all' ? orders.length : (counts[t[0]] || 0)) { %> <span class="tiny">(<%= t[0] === 'all' ? orders.length : counts[t[0]] %>)</span><% } %>
          </a>
        <% }); %>
      </div>

      <% if (!orders.length) { %>
        <div class="empty-state card">
          <div class="ico">&#128230;</div>
          <h3>No <%= status === 'all' ? '' : STATUS_META[status] ? STATUS_META[status].label.toLowerCase() : '' %> orders</h3>
          <p><%= status === 'all' ? 'You have not placed an order yet. Everything you buy will appear here with live tracking.' : 'Nothing matches that filter yet.' %></p>
          <a class="btn primary" href="/deals"><%- icon('fire') %> Start shopping</a>
        </div>
      <% } else { %>
        <div class="stack" style="gap:.9rem">
          <% orders.forEach(function (o) { %>
            <% const sm = STATUS_META[o.status] || { label: o.status, tone: 'muted' }; %>
            <% const items = o.preview || []; %>
            <div class="card pad">
              <div class="row between wrap" style="gap:.7rem;margin-bottom:.8rem">
                <div>
                  <b style="font-size:1rem"><a href="/account/orders/<%= o.order_number %>"><%= o.order_number %></a></b>
                  <div class="small muted">
                    Placed <%= dateFmt(o.placed_at, 'D MMM YYYY') %> ·
                    <%= o.item_count %> item<%= o.item_count === 1 ? '' : 's' %> ·
                    <%= o.payment_method === 'momo' ? 'Mobile Money' : o.payment_method === 'cod' ? 'Cash on delivery' : 'Card' %>
                  </div>
                </div>
                <div class="row" style="gap:.4rem;flex-wrap:wrap">
                  <span class="badge <%= sm.tone %>"><%= sm.label %></span>
                  <span class="badge <%= o.payment_status === 'paid' ? 'success' : 'outline' %>"><%= o.payment_status === 'paid' ? 'Paid' : o.payment_status.replace(/_/g, ' ') %></span>
                </div>
              </div>

              <div class="row wrap" style="gap:.5rem;margin-bottom:.8rem">
                <% items.slice(0, 5).forEach(function (i) { %>
                  <a href="/account/orders/<%= o.order_number %>" title="<%= i.name %>">
                    <img src="<%= imgSrc(i.image, { w: 120, h: 120, hint: settings.store_name, name: i.name }) %>" alt="<%= i.name %>" loading="lazy" style="width:52px;height:52px;border-radius:9px;object-fit:cover;border:1px solid #E8EDF3">
                  </a>
                <% }); %>
                <% if (items.length > 5) { %><span class="badge outline">+<%= items.length - 5 %> more</span><% } %>
                <div style="margin-left:auto;text-align:right">
                  <b style="font-size:1.05rem"><%= settings.currency_symbol %> <%= money(o.total) %></b>
                  <% if (o.tracking_number) { %><div class="tiny">Track: <%= o.tracking_number %></div><% } %>
                </div>
              </div>

              <div class="row wrap" style="gap:.45rem">
                <a class="btn primary sm" href="/account/orders/<%= o.order_number %>"><%- icon('eye') %> View order</a>
                <a class="btn ghost sm" href="/account/orders/<%= o.order_number %>/receipt" target="_blank"><%- icon('receipt') %> Receipt</a>
                <form action="/account/orders/<%= o.order_number %>/reorder" method="post" style="display:inline">
                  <button class="btn ghost sm" type="submit"><%- icon('refresh') %> Buy again</button>
                </form>
                <% if (['pending_payment', 'paid', 'processing'].includes(o.status)) { %>
                  <form action="/account/orders/<%= o.order_number %>/cancel" method="post" style="display:inline"
                        onsubmit="var r=prompt('Why are you cancelling? (optional)','Changed my mind');if(r===null)return false;this.querySelector('[name=reason]').value=r;return true;">
                    <input type="hidden" name="reason" value="">
                    <button class="btn ghost sm" type="submit" style="color:#D64545"><%- icon('x') %> Cancel</button>
                  </form>
                <% } %>
                <% if (o.status === 'pending_payment' && o.payment_status !== 'paid') { %>
                  <a class="btn success sm" href="/order/<%= o.order_number %>"><%- icon('wallet') %> Pay now</a>
                <% } %>
              </div>
            </div>
          <% }); %>
        </div>
      <% } %>
    </div>
  </div>
</main>
<%- include('../partials/footer') %>
