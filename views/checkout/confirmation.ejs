<%- include('../partials/head') %>
<%- include('../partials/header') %>
<%
  const sm = STATUS_META[order.status] || { label: order.status, tone: 'muted' };
  const flow = ['pending_payment', 'paid', 'processing', 'shipped', 'delivered'];
  const curIdx = flow.indexOf(order.status);
  const paid = order.payment_status === 'paid';
  const methodLabel = order.payment_method === 'momo' ? 'Mobile Money' : order.payment_method === 'cod' ? 'Cash on delivery' : 'Card';
  const deliveryLabel = order.delivery_method === 'express' ? 'Express (within 24 hours)' : order.delivery_method === 'pickup' ? 'Warehouse pickup' : 'Standard delivery';
%>
<main class="container" id="main" style="padding:1.2rem 0 2.6rem">
  <div class="confirm-hero">
    <% if (justPaid) { %>
      <div class="tick">&#10003;</div>
      <h1>Payment received — thank you!</h1>
      <p class="muted" style="max-width:60ch;margin:.4rem auto 0">We have confirmed <b><%= settings.currency_symbol %> <%= money(order.total) %></b> for order <b><%= order.order_number %></b>. Your items are being picked from our Accra warehouse now.</p>
    <% } else if (order.status === 'pending_payment' && !paid) { %>
      <div class="tick" style="background:#FFF6E5;color:#B7791F">&#8987;</div>
      <h1>Your order is reserved — awaiting payment</h1>
      <p class="muted" style="max-width:60ch;margin:.4rem auto 0">Order <b><%= order.order_number %></b> for <b><%= settings.currency_symbol %> <%= money(order.total) %></b> is saved. Complete the payment below and we will start packing immediately.</p>
    <% } else { %>
      <div class="tick">&#10003;</div>
      <h1>Order <%= order.order_number %> confirmed</h1>
      <p class="muted" style="max-width:60ch;margin:.4rem auto 0">Placed <%= dateFmt(order.placed_at, 'dddd, D MMMM YYYY [at] h:mm a') %>. Keep this order number — you will need it to track your delivery.</p>
    <% } %>

    <div class="row" style="justify-content:center;gap:.5rem;flex-wrap:wrap;margin-top:1.3rem">
      <span class="badge <%= sm.tone %> big"><%= sm.label %></span>
      <span class="badge <%= order.payment_status === 'paid' ? 'success' : 'warn' %> big"><%= order.payment_status === 'paid' ? 'Paid' : order.payment_status === 'refunded' ? 'Refunded' : 'Not paid yet' %></span>
      <span class="badge outline big"><%= methodLabel %></span>
      <span class="badge outline big"><%= order.item_count %> item<%= order.item_count === 1 ? '' : 's' %></span>
    </div>

    <div class="row" style="justify-content:center;gap:.55rem;flex-wrap:wrap;margin-top:1.3rem">
      <% if (!paid && order.status === 'pending_payment') { %>
        <% const ref = order.payments && order.payments.length ? order.payments[0].reference : null; %>
        <a class="btn primary lg" href="/pay/<%= ref %>"><%- icon('wallet') %> Pay <%= settings.currency_symbol %> <%= money(order.total) %> now</a>
      <% } %>
      <a class="btn ghost lg" href="/order/<%= order.order_number %>/receipt" target="_blank"><%- icon('printer') %> Print receipt</a>
      <a class="btn ghost lg" href="/"><%- icon('home') %> Continue shopping</a>
      <% if (user && (!order.user_id || order.user_id === user.id)) { %>
        <a class="btn ghost lg" href="/account/orders"><%- icon('box') %> My orders</a>
      <% } %>
    </div>
  </div>

  <% if (curIdx >= 0 && !['cancelled', 'refunded'].includes(order.status)) { %>
    <div class="order-progress">
      <% flow.forEach(function (s, i) { %>
        <div class="seg <%= i < curIdx ? 'done' : '' %> <%= i === curIdx ? 'current' : '' %>"><%= STATUS_META[s].label %></div>
      <% }); %>
    </div>
  <% } %>

  <div class="grid g-3" style="grid-template-columns:2fr 1fr;gap:1.1rem;margin-top:1.4rem">
    <div>
      <div class="card">
        <div class="summary-head"><span><%- icon('box') %> What you ordered</span><span class="small"><%= order.order_number %></span></div>
        <div class="summary-body">
          <% order.items.forEach(function (i) { %>
            <div class="row" style="gap:.7rem;padding:.6rem 0;border-bottom:1px dashed #E8EDF3">
              <a href="<%= i.slug ? '/p/' + i.slug : '#' %>" style="flex:none">
                <img src="<%= imgSrc(i.image, { w: 140, h: 140, hint: settings.store_name, name: i.name }) %>" alt="" loading="lazy" style="width:58px;height:58px;border-radius:10px;object-fit:cover;border:1px solid #E8EDF3">
              </a>
              <span class="grow">
                <b style="display:block;font-size:.9rem;line-height:1.35"><%= i.name %></b>
                <span class="small muted">
                  <% if (i.variant_title) { %>Option: <%= i.variant_title %> · <% } %>
                  <% if (i.sku) { %>SKU <%= i.sku %> · <% } %>
                  Qty <%= i.qty %> × <%= settings.currency_symbol %> <%= money(i.price) %>
                </span>
              </span>
              <b style="flex:none"><%= settings.currency_symbol %> <%= money(i.total) %></b>
            </div>
          <% }); %>
          <div style="padding-top:.9rem">
            <div class="sum-row"><span>Subtotal</span><b><%= settings.currency_symbol %> <%= money(order.subtotal) %></b></div>
            <% if (order.discount > 0) { %><div class="sum-row"><span>Discount <%= order.coupon_code ? '(' + order.coupon_code + ')' : '' %></span><b class="save">− <%= settings.currency_symbol %> <%= money(order.discount) %></b></div><% } %>
            <div class="sum-row"><span>Delivery (<%= deliveryLabel %>)</span><b><%= order.shipping_fee > 0 ? settings.currency_symbol + ' ' + money(order.shipping_fee) : 'FREE' %></b></div>
            <% if (order.tax > 0) { %><div class="sum-row"><span>Tax</span><b><%= settings.currency_symbol %> <%= money(order.tax) %></b></div><% } %>
            <div class="sum-row total"><span>Total <%= paid ? 'paid' : 'due' %></span><b><%= settings.currency_symbol %> <%= money(order.total) %></b></div>
          </div>
        </div>
      </div>

      <div class="card" style="margin-top:1.1rem">
        <div class="summary-head"><span><%- icon('activity') %> Order timeline</span></div>
        <div class="summary-body">
          <% if (order.events && order.events.length) { %>
            <div class="timeline">
              <% order.events.slice().reverse().forEach(function (e) { %>
                <div class="tl-item">
                  <span class="dot"></span>
                  <div>
                    <b class="small"><%= STATUS_META[e.status] ? STATUS_META[e.status].label : e.status %></b>
                    <span class="tiny" style="color:#64748B;display:block"><%= dateFmt(e.created_at, 'D MMM YYYY, h:mm a') %> · by <%= e.actor %></span>
                    <% if (e.note) { %><p class="small" style="margin:.2rem 0 0"><%= e.note %></p><% } %>
                  </div>
                </div>
              <% }); %>
            </div>
          <% } else { %>
            <p class="muted small">No updates yet — your order has just been placed.</p>
          <% } %>
        </div>
      </div>
    </div>

    <aside>
      <div class="card">
        <div class="summary-head"><span><%- icon('truck') %> Delivery details</span></div>
        <div class="summary-body small">
          <b style="display:block;margin-bottom:.2rem"><%= order.ship_name %></b>
          <span class="muted"><%= order.ship_line %><% if (order.ship_landmark) { %><br>Near: <%= order.ship_landmark %><% } %><br><%= order.ship_city %>, <%= order.ship_region %></span>
          <div class="divider" style="margin:.8rem 0"></div>
          <span class="row" style="gap:.4rem"><%- icon('phone') %> <%= order.ship_phone %></span>
          <% if (order.ship_email) { %><span class="row" style="gap:.4rem;margin-top:.3rem"><%- icon('mail') %> <%= order.ship_email %></span><% } %>
          <div class="divider" style="margin:.8rem 0"></div>
          <span class="row" style="gap:.4rem"><%- icon('truck') %> <%= deliveryLabel %></span>
          <% if (order.tracking_number) { %>
            <span class="row" style="gap:.4rem;margin-top:.3rem"><%- icon('tag') %> Tracking: <b><%= order.tracking_number %></b><% if (order.carrier) { %> (<%= order.carrier %>)<% } %></span>
          <% } %>
          <% if (order.delivery_note) { %><p class="muted" style="margin-top:.5rem;font-style:italic">“<%= order.delivery_note %>”</p><% } %>
        </div>
      </div>

      <div class="card" style="margin-top:1rem">
        <div class="summary-head"><span><%- icon('wallet') %> Payment</span></div>
        <div class="summary-body small">
          <span class="row between"><span class="muted">Method</span><b><%= methodLabel %></b></span>
          <span class="row between" style="margin-top:.35rem"><span class="muted">Status</span><b><%= order.payment_status === 'paid' ? 'Paid' : order.payment_status.replace(/_/g, ' ') %></b></span>
          <% const p = order.payments && order.payments.length ? order.payments[0] : null; %>
          <% if (p) { %>
            <span class="row between" style="margin-top:.35rem"><span class="muted">Reference</span><b style="font-size:.78rem"><%= p.reference %></b></span>
            <% if (p.paid_at) { %><span class="row between" style="margin-top:.35rem"><span class="muted">Paid at</span><b><%= dateFmt(p.paid_at, 'D MMM, h:mm a') %></b></span><% } %>
            <% if (p.last4) { %><span class="row between" style="margin-top:.35rem"><span class="muted">Card</span><b>•••• <%= p.last4 %></b></span><% } %>
            <% if (p.channel === 'mobile_money' && p.payer) { %><span class="row between" style="margin-top:.35rem"><span class="muted">MoMo</span><b><%= p.payer %></b></span><% } %>
          <% } %>
          <% if (order.payment_method === 'cod' && !paid) { %>
            <div class="inline-alert" style="margin-top:.7rem">Please have <b><%= settings.currency_symbol %> <%= money(order.total) %></b> ready in cash for the rider.</div>
          <% } %>
        </div>
      </div>

      <div class="card pad" style="margin-top:1rem;text-align:center">
        <div class="tiny" style="margin-bottom:.5rem">Questions about this order?</div>
        <a class="btn primary sm block" href="https://wa.me/<%= (settings.support_whatsapp || '').replace(/[^0-9]/g,'') %>?text=Hello,%20I%20have%20a%20question%20about%20order%20<%= order.order_number %>" target="_blank" rel="noopener"><%- icon('whatsapp') %> WhatsApp us</a>
        <a class="btn ghost sm block" style="margin-top:.4rem" href="/contact"><%- icon('mail') %> Contact support</a>
        <p class="tiny muted" style="margin-top:.6rem">We reply within <%= settings.support_hours || 'business hours' %>.</p>
      </div>
    </aside>
  </div>

  <% if (topDeals && topDeals.length) { %>
    <div class="section">
      <div class="section-head"><h2>Customers also bought</h2><a class="link" href="/best-sellers">See best sellers</a></div>
      <div class="p-grid"><% topDeals.slice(0, 5).forEach(function (p) { %><%- include('../partials/product-card', { p: p }) %><% }); %></div>
    </div>
  <% } %>
</main>
<%- include('../partials/footer') %>
