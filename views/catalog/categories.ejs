<%- include('../partials/head') %>
<%- include('../partials/header') %>
<main class="container" id="main" style="padding:1rem 0 2.4rem">
  <nav class="breadcrumbs dark"><a href="/">Home</a><span class="sep">/</span><span class="cur">Fashion</span></nav>
  <span class="section-eyebrow">The Biahens collection</span>
  <h1>Explore fashion.</h1>
  <p class="muted" style="margin:0 0 1.4rem;max-width:80ch"><%= total %> owner-curated pieces across clothing, Ghanaian heritage, shoes, bags and accessories. One seller, one point of view — choose a category and find your next favourite.</p>

  <div class="grid" style="grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:1.1rem">
    <% cats.forEach(function (c) { %>
      <div class="card pad" style="border-top:4px solid <%= c.accent || '#0F2A43' %>">
        <a href="/c/<%= c.slug %>" class="row" style="gap:.7rem;margin-bottom:.7rem">
          <span class="ico" style="width:46px;height:46px;border-radius:13px;display:grid;place-items:center;font-size:1.4rem;background:color-mix(in srgb,<%= c.accent || '#0F2A43' %> 12%,#fff)"><%= c.icon || '&#128722;' %></span>
          <span class="grow">
            <b style="display:block;font-size:1.02rem;color:#0B1A27"><%= c.name %></b>
            <span class="small muted"><%= c.total_count || 0 %> product<%= (c.total_count || 0) === 1 ? '' : 's' %></span>
          </span>
          <%- icon('chevron-right') %>
        </a>
        <% if (c.children && c.children.length) { %>
        <div class="row wrap" style="gap:.35rem">
          <% c.children.forEach(function (sc) { %>
            <a class="sub-cat" style="padding:.28rem .65rem;font-size:.8rem" href="/c/<%= sc.slug %>"><%= sc.name %> <span class="muted">(<%= sc.product_count || 0 %>)</span></a>
          <% }); %>
        </div>
        <% } %>
        <% if (c.description) { %><p class="small muted" style="margin:.7rem 0 0"><%= truncate(c.description, 120) %></p><% } %>
      </div>
    <% }); %>
  </div>
</main>
<%- include('../partials/footer') %>
