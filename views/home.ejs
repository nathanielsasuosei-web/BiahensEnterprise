<%- include('partials/head') %>
<%- include('partials/header') %>

<main id="main">

  <%# ───────────────────────── hero carousel + side promos ─────────────── %>
  <section class="container" style="margin-top:1.2rem">
    <div class="grid" style="grid-template-columns:minmax(0,1fr) 320px;gap:1rem" id="heroGrid">
      <div class="hero" id="hero" data-hero data-interval="6500" data-end="<%= dealEnds %>">
        <div class="hero-track" data-hero-track>
          <% slides.forEach(function (s) { %>
            <div class="slide" style="background:<%= s.bg %>">
              <div class="slide-body">
                <% if (s.badge) { %><span class="badge"><%= s.badge %></span><% } %>
                <h2><%= s.title %></h2>
                <p><%= s.subtitle %></p>
                <div class="row wrap">
                  <a class="btn gold lg" href="<%= s.link_url || '/deals' %>"><%= s.link_text || 'Shop now' %> <%- icon('arrow-right') %></a>
                  <a class="btn lg" style="background:rgba(255,255,255,.14);border-color:rgba(255,255,255,.3)" href="/categories">Browse all categories</a>
                </div>
                <div class="row" style="gap:1.1rem;margin-top:1.3rem;flex-wrap:wrap">
                  <span class="row small" style="color:rgba(255,255,255,.9)"><%- icon('truck') %> <%= settings.hero_note %></span>
                  <span class="row small" style="color:rgba(255,255,255,.9)"><%- icon('shield') %> Genuine stock only</span>
                  <span class="row small" style="color:rgba(255,255,255,.9)"><%- icon('refresh') %> <%= settings.return_days %>-day returns</span>
                </div>
              </div>
              <% if (s.image) { %><img class="deco" src="<%= s.image %>" alt="" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.35;z-index:0"><% } %>
              <svg class="deco" viewBox="0 0 200 200" aria-hidden="true"><circle cx="100" cy="100" r="86" fill="none" stroke="#fff" stroke-width="1.4" opacity=".5"/><circle cx="100" cy="100" r="58" fill="none" stroke="#fff" stroke-width="1.4" opacity=".35"/><circle cx="100" cy="100" r="30" fill="#fff" opacity=".1"/></svg>
            </div>
          <% }); %>
        </div>
        <div class="hero-dots" data-hero-dots>
          <% slides.forEach(function (s, i) { %>
            <button type="button" class="<%= i === 0 ? 'active' : '' %>" data-slide="<%= i %>" aria-label="Slide <%= i + 1 %>"></button>
          <% }); %>
        </div>
        <div class="hero-nav">
          <button type="button" data-hero-prev aria-label="Previous slide"><%- icon('chevron-left') %></button>
          <button type="button" data-hero-next aria-label="Next slide"><%- icon('chevron-right') %></button>
        </div>
      </div>

      <div class="stack" style="gap:1rem">
        <div class="card pad" style="background:linear-gradient(140deg,#0F2A43,#1D4E6B);color:#fff;border:0">
          <div class="row between" style="margin-bottom:.5rem">
            <span class="badge gold"><%- icon('fire') %> Flash deals</span>
            <span class="tiny" style="color:#B9CBDA">Ends in</span>
          </div>
          <div class="countdown" data-countdown="<%= dealEnds %>" style="margin-bottom:.85rem">
            <b data-cd-h>00</b><span>hrs</span><b data-cd-m>00</b><span>min</span><b data-cd-s>00</b><span>sec</span>
          </div>
          <p style="color:#C7D6E2;font-size:.86rem;margin-bottom:.8rem">Up to 35% off selected electronics, fashion and home appliances. Stock is limited.</p>
          <a class="btn gold block" href="/deals">See all deals <%- icon('arrow-right') %></a>
        </div>

        <div class="card pad">
          <div class="row" style="gap:.6rem;margin-bottom:.7rem">
            <span style="width:36px;height:36px;border-radius:11px;background:#E6F5EF;color:#12805C;display:grid;place-items:center"><%- icon('shield') %></span>
            <div><b style="display:block;font-size:.92rem">Buy with confidence</b><span class="small muted"><%= productTotal %> products in stock today</span></div>
          </div>
          <ul class="stack" style="gap:.42rem;font-size:.84rem">
            <li class="row" style="gap:.45rem"><span style="color:#12805C">&#10003;</span> Owner-sourced stock — no third-party sellers</li>
            <li class="row" style="gap:.45rem"><span style="color:#12805C">&#10003;</span> MoMo, card or cash on delivery</li>
            <li class="row" style="gap:.45rem"><span style="color:#12805C">&#10003;</span> Same-day dispatch in Accra before 2pm</li>
            <li class="row" style="gap:.45rem"><span style="color:#12805C">&#10003;</span> <%= settings.return_days %>-day returns &amp; <%= settings.warranty_note.split('.')[0] %></li>
          </ul>
          <a class="btn ghost sm block" href="/sell-with-us" style="margin-top:.8rem">How our single-seller model works</a>
        </div>

        <div class="card pad" style="background:#FFF7F1;border-color:#FFE0CC">
          <b style="display:block;font-size:.95rem;margin-bottom:.2rem">Track an order</b>
          <p class="small muted" style="margin-bottom:.65rem">Enter your order number to see exactly where it is.</p>
          <a class="btn primary sm block" href="/track-order"><%- icon('package') %> Track my delivery</a>
        </div>
      </div>
    </div>
  </section>

  <%# ───────────────────────────── category tiles ──────────────────────── %>
  <section class="container section">
    <div class="section-head">
      <div>
        <h2>Shop by category</h2>
        <p class="muted small" style="margin:0">Twelve departments, one warehouse on Spintex Road.</p>
      </div>
      <a class="link" href="/categories">See all categories <%- icon('arrow-right') %></a>
    </div>
    <div class="cat-tiles">
      <% cats.forEach(function (c) { %>
        <a class="cat-tile" href="/c/<%= c.slug %>" style="--accent:<%= c.accent %>">
          <span class="ico"><%= c.icon || '&#128722;' %></span>
          <b><%= c.name %></b>
          <span><%= c.total_count || c.product_count || 0 %> items</span>
        </a>
      <% }); %>
    </div>
  </section>

  <%# ──────────────────────────── flash deals rail ─────────────────────── %>
  <% if (settings.rail_flash === 'true' && flashDeals.length) { %>
  <section class="container section" style="padding-top:0">
    <div class="deal-strip">
      <div class="grow">
        <h3><%- icon('zap') %> Flash deals — up to 35% off</h3>
        <p>Prices drop daily at 6am. When stock is gone, it is gone.</p>
      </div>
      <div class="countdown" data-countdown="<%= dealEnds %>">
        <b data-cd-h>00</b><b data-cd-m>00</b><b data-cd-s>00</b>
      </div>
      <a class="btn light" href="/deals">All deals <%- icon('arrow-right') %></a>
    </div>
    <div class="rail">
      <div class="rail-scroll" data-rail>
        <% flashDeals.forEach(function (p) { %>
          <div style="width:215px"><%- include('partials/product-card', { p: p }) %></div>
        <% }); %>
      </div>
      <div class="rail-btns" style="position:absolute;top:-52px;right:0">
        <button class="rail-btn" type="button" data-rail-prev aria-label="Scroll left"><%- icon('chevron-left') %></button>
        <button class="rail-btn" type="button" data-rail-next aria-label="Scroll right"><%- icon('chevron-right') %></button>
      </div>
    </div>
  </section>
  <% } %>

  <%# ──────────────────────────── promo banners ────────────────────────── %>
  <section class="container" style="padding-bottom:2rem">
    <div class="promo-grid">
      <a class="promo" href="/c/phones-tablets" style="background:linear-gradient(120deg,#0F2A43,#2E86AB)">
        <span class="badge">Phones &amp; tablets</span>
        <h3>Upgrade your handset</h3>
        <p>Samsung, iPhone, Tecno, Infinix and Xiaomi — all with a Biahens warranty.</p>
        <span class="btn light sm" style="align-self:flex-start">Shop phones</span>
        <span class="deco">&#128241;</span>
      </a>
      <a class="promo" href="/c/fashion" style="background:linear-gradient(120deg,#5A1B32,#C2476B)">
        <span class="badge">Fashion</span>
        <h3>Ankara, kente &amp; streetwear</h3>
        <p>Cut and sewn in Accra. Sizes XS to XXL, delivered in 1–3 days.</p>
        <span class="btn light sm" style="align-self:flex-start">Explore fashion</span>
        <span class="deco">&#128087;</span>
      </a>
      <a class="promo" href="/c/home-kitchen" style="background:linear-gradient(120deg,#0A3B2C,#2FA37C)">
        <span class="badge">Home &amp; kitchen</span>
        <h3>Equip the whole house</h3>
        <p>Fridges, air fryers, cookware and furniture — installation available in Accra.</p>
        <span class="btn light sm" style="align-self:flex-start">Shop home</span>
        <span class="deco">&#127859;</span>
      </a>
    </div>
  </section>

  <%# ──────────────────────────── featured rail ────────────────────────── %>
  <% if (settings.rail_featured === 'true' && featured.length) { %>
  <section class="container section" style="padding-top:0">
    <div class="section-head">
      <div><h2><%- icon('spark') %> Featured by the owner</h2>
        <p class="muted small" style="margin:0">Hand-picked stock we would buy ourselves.</p></div>
      <a class="link" href="/search?q=&sort=popular">View all featured</a>
    </div>
    <div class="rail">
      <div class="rail-scroll" data-rail>
        <% featured.forEach(function (p) { %>
          <div style="width:215px"><%- include('partials/product-card', { p: p }) %></div>
        <% }); %>
      </div>
      <div class="rail-btns" style="position:absolute;top:-52px;right:0">
        <button class="rail-btn" type="button" data-rail-prev aria-label="Scroll left"><%- icon('chevron-left') %></button>
        <button class="rail-btn" type="button" data-rail-next aria-label="Scroll right"><%- icon('chevron-right') %></button>
      </div>
    </div>
  </section>
  <% } %>

  <%# ─────────────────────────── best sellers grid ─────────────────────── %>
  <% if (settings.rail_best === 'true' && bestSellers.length) { %>
  <section class="container section" style="padding-top:0">
    <div class="section-head">
      <div><h2><%- icon('medal') %> Best sellers in Ghana</h2>
        <p class="muted small" style="margin:0">Ranked by units sold over the last 30 days.</p></div>
      <a class="link" href="/best-sellers">See the full ranking</a>
    </div>
    <div class="p-grid">
      <% bestSellers.slice(0, 12).forEach(function (p) { %>
        <%- include('partials/product-card', { p: p }) %>
      <% }); %>
    </div>
  </section>
  <% } %>

  <%# ───────────────────────────── brand strip ─────────────────────────── %>
  <% if (brands.length) { %>
  <section class="container section" style="padding-top:0">
    <div class="section-head">
      <div><h2>Brands we stock</h2><p class="muted small" style="margin:0">Authorised stock, serial-verified on arrival.</p></div>
      <a class="link" href="/brands">All brands</a>
    </div>
    <div class="brand-strip">
      <% brands.forEach(function (b) { %>
        <a class="brand-chip" href="/b/<%= b.slug %>"><b><%= b.name %></b><span><%= truncate(b.tagline || 'Shop brand', 24) %></span></a>
      <% }); %>
    </div>
  </section>
  <% } %>

  <%# ──────────────────────────── new arrivals ─────────────────────────── %>
  <% if (settings.rail_new === 'true' && newArrivals.length) { %>
  <section class="container section" style="padding-top:0">
    <div class="section-head">
      <div><h2><%- icon('package') %> Just landed</h2><p class="muted small" style="margin:0">Fresh stock from our last shipment.</p></div>
      <a class="link" href="/new-arrivals">All new arrivals</a>
    </div>
    <div class="rail">
      <div class="rail-scroll" data-rail>
        <% newArrivals.forEach(function (p) { %>
          <div style="width:215px"><%- include('partials/product-card', { p: p }) %></div>
        <% }); %>
      </div>
      <div class="rail-btns" style="position:absolute;top:-52px;right:0">
        <button class="rail-btn" type="button" data-rail-prev aria-label="Scroll left"><%- icon('chevron-left') %></button>
        <button class="rail-btn" type="button" data-rail-next aria-label="Scroll right"><%- icon('chevron-right') %></button>
      </div>
    </div>
  </section>
  <% } %>

  <%# ─────────────────────── budget picks + trust strip ────────────────── %>
  <section class="container section" style="padding-top:0">
    <% if (budgetPicks.length) { %>
    <div class="section-head">
      <div><h2><%- icon('wallet') %> Great value under GH&#8373;500</h2>
        <p class="muted small" style="margin:0">Small budgets, solid quality.</p></div>
      <a class="link" href="/search?max=500&sort=rating">Shop the range</a>
    </div>
    <div class="rail" style="margin-bottom:2rem">
      <div class="rail-scroll" data-rail>
        <% budgetPicks.forEach(function (p) { %>
          <div style="width:200px"><%- include('partials/product-card', { p: p }) %></div>
        <% }); %>
      </div>
      <div class="rail-btns" style="position:absolute;top:-52px;right:0">
        <button class="rail-btn" type="button" data-rail-prev aria-label="Scroll left"><%- icon('chevron-left') %></button>
        <button class="rail-btn" type="button" data-rail-next aria-label="Scroll right"><%- icon('chevron-right') %></button>
      </div>
    </div>
    <% } %>

    <% if (settings.trust_strip === 'true') { %>
    <div class="trust">
      <div class="trust-item"><span class="ico"><%- icon('truck') %></span><div><b>Fast nationwide delivery</b><span>Same day in Accra &amp; Tema, 1–6 days to every other region.</span></div></div>
      <div class="trust-item"><span class="ico"><%- icon('wallet') %></span><div><b>Pay your way</b><span>MTN MoMo, Telecel Cash, AT Money, Visa/Mastercard or cash on delivery.</span></div></div>
      <div class="trust-item"><span class="ico"><%- icon('refresh') %></span><div><b><%= settings.return_days %>-day returns</b><span>Changed your mind? Return unused items in original packaging.</span></div></div>
      <div class="trust-item"><span class="ico"><%- icon('support') %></span><div><b>Real human support</b><span><%= settings.support_hours %> on <%= settings.support_phone %>.</span></div></div>
    </div>
    <% } %>
  </section>

  <%# ──────────────────────── SEO / about the store ────────────────────── %>
  <section class="container" style="padding-bottom:2.4rem">
    <div class="card pad">
      <div class="grid g-2" style="gap:1.6rem">
        <div>
          <h2>Online shopping in Ghana, done properly</h2>
          <div class="prose" style="font-size:.89rem">
            <p><%= settings.store_name %> is a Ghanaian online store stocking phones and tablets, electronics, computing, fashion, shoes and bags, home and kitchen goods, large appliances, beauty, groceries, sports equipment, tools and books. We hold our own stock in Accra and dispatch to all sixteen regions.</p>
            <p>Unlike open marketplaces, Biahens Enterprise is a <b>single-seller store</b>: only the owner lists products. That means every listing is checked, every price is real, every item is physically in our warehouse — and when something goes wrong there is one person accountable. <a href="/sell-with-us" style="color:#F26B21;font-weight:700">Read our single-seller promise &rsaquo;</a></p>
          </div>
        </div>
        <div>
          <h3 style="margin-bottom:.7rem">Why customers choose us</h3>
          <div class="grid g-2" style="gap:.7rem">
            <% [
              ['Genuine products only','Serial-checked on arrival, sourced from authorised distributors.'],
              ['Transparent pricing','The price you see includes duty and VAT. No surprise fees.'],
              ['Same-day Accra dispatch','Order before 2:00pm and it leaves the warehouse today.'],
              ['Local payment options','MTN, Telecel and AT Mobile Money accepted at checkout.'],
              ['Easy returns','7 days to change your mind on eligible items.'],
              ['Owner you can reach','Call or WhatsApp — a real person answers.']
            ].forEach(function (f) { %>
              <div class="card pad" style="box-shadow:none">
                <b style="display:block;font-size:.87rem;margin-bottom:.2rem"><%- icon('check-circle') %> <%= f[0] %></b>
                <span class="small muted"><%= f[1] %></span>
              </div>
            <% }); %>
          </div>
        </div>
      </div>
    </div>
  </section>

</main>

<%- include('partials/footer') %>
