<%- include('partials/head') %>
<%- include('partials/header') %>
<%
  const campaign = (slides || []).find(function (slide) { return slide.is_active; }) || {};
  const titleParts = String(campaign.title || 'Good style. Great finds.').split('. ');
%>
<main id="main" class="store-home">
  <section class="container campaign-section" aria-labelledby="heroTitle">
    <div class="store-intro"><span>A little inspiration. A lot to love.</span><a href="/categories">Your everyday fashion destination <%- icon('arrow-right') %></a></div>
    <div class="campaign-grid">
      <div class="shop-hero">
        <img class="shop-hero__image" src="<%= campaign.image || '/img/storefront/new-season.jpg' %>" alt="Two models in relaxed linen, neutral tones and everyday essentials" fetchpriority="high" width="1536" height="1024">
        <div class="shop-hero__copy">
          <span class="campaign-kicker"><span class="kicker-dot"></span><%= campaign.badge || 'NEW SEASON. NEW ENERGY.' %></span>
          <h1 id="heroTitle"><% titleParts.forEach(function (part, index) { %><span><%= part %><%= index < titleParts.length - 1 ? '.' : '' %></span><% }); %></h1>
          <p><%= campaign.subtitle || 'Everyday essentials. Stand-out pieces. Discover fashion that feels a little more like you.' %></p>
          <a class="btn shop-button" href="<%= campaign.link_url || '/new-arrivals' %>"><%= campaign.link_text || 'Shop new arrivals' %><%- icon('arrow-right') %></a>
          <div class="hero-footnote"><span class="little-star" aria-hidden="true">✳</span> Hand-picked in Accra. Made for your everyday.</div>
        </div>
        <span class="hero-collection-label">THE EVERYDAY COLLECTION / <%= new Date().getFullYear() %></span>
      </div>
      <div class="campaign-side">
        <a class="mini-campaign mini-campaign--shoes" href="/c/sneakers">
          <img src="/img/fashion/sneakers.jpg" alt="White everyday sneakers with gum soles" width="1024" height="1024">
          <div class="mini-campaign__copy"><span class="eyebrow">A FRESH START</span><h2>New kicks.<br>Good moves.</h2><span class="mini-campaign__link">Shop sneakers <%- icon('arrow-right') %></span></div>
          <span class="campaign-round-arrow" aria-hidden="true"><%- icon('external') %></span>
        </a>
        <a class="mini-campaign mini-campaign--heritage" href="/c/traditional-wear">
          <img src="/img/fashion/biahens-editorial.jpg" alt="Contemporary Ghanaian heritage fashion in burgundy and gold" width="1264" height="848">
          <div class="mini-campaign__copy"><span class="eyebrow">ROOTED IN GHANA</span><h2>A little heritage.<br>A lot of you.</h2><span class="mini-campaign__link">Explore the collection <%- icon('arrow-right') %></span></div>
          <span class="campaign-round-arrow" aria-hidden="true"><%- icon('external') %></span>
        </a>
      </div>
    </div>
    <div class="shopping-perks" aria-label="Shopping made easy">
      <a href="/shipping-delivery"><span class="perk-icon"><%- icon('truck') %></span><span><b>All roads lead to you</b><small>Delivery across all 16 regions</small></span></a>
      <a href="/faq"><span class="perk-icon"><%- icon('shield') %></span><span><b>Your way to pay</b><small>Mobile Money, card or cash on delivery</small></span></a>
      <a href="/returns-refunds"><span class="perk-icon"><%- icon('refresh') %></span><span><b>A little peace of mind</b><small><%= settings.return_days %>-day returns on eligible items</small></span></a>
      <a href="/contact"><span class="perk-icon"><%- icon('message') %></span><span><b>Real people. Real help.</b><small>Our Accra team is here for you</small></span></a>
    </div>
  </section>

  <section class="container shop-section departments-section" aria-labelledby="departmentsTitle">
    <div class="shop-section-heading"><div><span class="eyebrow">EVERYDAY NEEDS. ONE PLACE.</span><h2 id="departmentsTitle">Shop every department.</h2><p>Fashion, tech, home and all the little things in between.</p></div><a class="text-link" href="/categories">All categories <%- icon('arrow-right') %></a></div>
    <div class="department-grid">
      <% departments.forEach(function (department) { %><a class="department-card" href="/c/<%= department.slug %>"><span class="department-icon" aria-hidden="true"><%- departmentIcon(department.slug) %></span><span><%= department.name %></span><%- icon('chevron-right') %></a><% }); %>
    </div>
  </section>

  <% if (shopCategories.length) { %>
    <section class="container shop-section category-section" aria-labelledby="categoriesTitle">
      <div class="shop-section-heading"><div><span class="eyebrow">FIND YOUR NEXT FAVOURITE</span><h2 id="categoriesTitle">What are you shopping for?</h2></div><a class="text-link" href="/categories">Explore all categories <%- icon('arrow-right') %></a></div>
      <div class="shop-category-grid">
        <% shopCategories.forEach(function (category) { %>
          <a class="shop-category" href="/c/<%= category.slug %>">
            <div class="shop-category__image"><img src="<%= category.photo %>" alt="<%= category.label %> fashion" width="400" height="400" loading="lazy"><span class="category-open" aria-hidden="true"><%- icon('arrow-right') %></span></div>
            <div class="shop-category__label"><h3><%= category.label %></h3><span><%= category.total_count || category.product_count || 0 %> styles</span></div>
          </a>
        <% }); %>
      </div>
    </section>
  <% } %>

  <% if (shoppingGroups.length) { %>
    <section class="container shop-section favourites-section" aria-labelledby="favouritesTitle" data-product-tabs>
      <div class="shop-section-heading"><div><span class="eyebrow">THE PIECES EVERYONE'S EYEING</span><h2 id="favouritesTitle">Trending for a reason<span class="heading-dot">.</span></h2><p>Good finds, hand-picked. A little something for your everyday.</p></div><a class="text-link" href="/best-sellers">Shop all bestsellers <%- icon('arrow-right') %></a></div>
      <div class="product-tabs" role="tablist" aria-label="Shop trending products">
        <% shoppingGroups.forEach(function (group, index) { %><button class="product-tab <%= index === 0 ? 'active' : '' %>" type="button" role="tab" id="tab-<%= group.id %>" aria-controls="products-<%= group.id %>" aria-selected="<%= index === 0 ? 'true' : 'false' %>" tabindex="<%= index === 0 ? '0' : '-1' %>" data-product-tab="<%= group.id %>"><%= group.label %><% if (index === 0) { %><%- icon('spark') %><% } %></button><% }); %>
      </div>
      <% shoppingGroups.forEach(function (group, index) { %>
        <div class="product-tab-panel" role="tabpanel" id="products-<%= group.id %>" aria-labelledby="tab-<%= group.id %>" tabindex="0" <%= index === 0 ? '' : 'hidden' %>>
          <div class="home-product-grid"><% group.items.forEach(function (p) { %><%- include('partials/product-card', { p: p }) %><% }); %></div>
          <a class="collection-more" href="<%= group.url %>">Find more to love <%- icon('arrow-right') %></a>
        </div>
      <% }); %>
      <noscript><p class="small">Explore the collections: <% shoppingGroups.slice(1).forEach(function (group) { %><a class="text-link" href="<%= group.url %>"><%= group.label %> →</a> &nbsp;<% }); %></p></noscript>
    </section>
  <% } %>

  <section class="container" aria-labelledby="everydayTitle">
    <div class="everyday-banner">
      <div class="everyday-banner__image"><img src="/img/fashion/mens-oxford.jpg" alt="An easy cotton Oxford shirt, styled for everyday wear" width="1024" height="1024" loading="lazy"></div>
      <div class="everyday-banner__copy"><span class="eyebrow">LESS EFFORT. MORE YOU.</span><h2 id="everydayTitle">Big on style.<br>Easy on the everyday.</h2><p>The shirt you reach for. The shoes that go everywhere. Meet the pieces that make getting dressed the easy part.</p><a class="btn shop-button" href="/search?max=500">Discover styles under <%= settings.currency_symbol %>500 <%- icon('arrow-right') %></a><span class="banner-caption">Everyday favourites. Unexpectedly good prices.</span></div>
      <span class="banner-spark" aria-hidden="true"><%- icon('asterisk') %></span>
    </div>
  </section>

  <% if (salePicks.length) { %>
    <section class="sale-section" aria-labelledby="saleTitle"><div class="container shop-section">
      <div class="shop-section-heading"><div><span class="eyebrow"><%- icon('tag') %> GOOD STYLE, EVEN BETTER PRICES</span><h2 id="saleTitle">Love the look. Love the price.</h2><p>A little less to spend. A whole lot to love.</p></div><a class="text-link" href="/deals">Shop all offers <%- icon('arrow-right') %></a></div>
      <div class="home-product-grid"><% salePicks.forEach(function (p) { %><%- include('partials/product-card', { p: p }) %><% }); %></div>
    </div></section>
  <% } %>

  <section class="container owner-promise" aria-labelledby="promiseTitle"><span class="promise-symbol" aria-hidden="true"><%- icon('asterisk') %></span><div><span class="eyebrow">A LITTLE MORE PERSONAL</span><h2 id="promiseTitle">Not a marketplace. Your kind of store.</h2><p>One owner. Every piece personally picked. From the first click to your front door, we put a little more care into the things you wear.</p></div><a class="text-link" href="/about">Meet POINTGH <%- icon('arrow-right') %></a></section>
</main>
<%- include('partials/footer') %>
