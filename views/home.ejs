<%- include('partials/head') %>
<%- include('partials/header') %>
<%
  const heroSlide = (slides || []).find(function (item) { return item.is_active; }) || null;
  const heroParts = heroSlide ? String(heroSlide.title || '').split('. ') : ['Wear your story', 'Own every room'];
  const heroHasSplitTitle = heroParts.length > 1;
  const heroTitleMain = heroHasSplitTitle ? (heroParts.shift() || 'Wear your story') : (heroSlide ? String(heroSlide.title || 'Biahens fashion') : 'Wear your story');
  const heroTitleAccent = heroHasSplitTitle ? heroParts.join('. ') : (heroSlide ? '' : 'Own every room.');
%>

<main id="main" class="fashion-home">
  <div class="home-utility">
    <div class="container">
      <span><i></i> One owner. Every piece hand-picked.</span>
      <span><i></i> Ghanaian style, made to move with you.</span>
      <span><i></i> Secure checkout · Nationwide delivery</span>
    </div>
  </div>

  <section class="container" aria-labelledby="heroTitle">
    <div class="fashion-hero">
      <div class="fashion-hero__image" aria-hidden="true">
        <img src="/img/fashion/biahens-editorial.jpg" alt="" fetchpriority="high">
      </div>
      <div class="fashion-hero__content">
        <div class="fashion-eyebrow"><%= heroSlide && heroSlide.badge ? heroSlide.badge : 'The Biahens edit · Accra, Ghana' %></div>
        <h1 id="heroTitle"><%= heroTitleMain %><% if (heroTitleAccent) { %><br><em><%= heroTitleAccent %></em><% } %></h1>
        <p><%= heroSlide && heroSlide.subtitle ? heroSlide.subtitle : 'Modern fashion with a point of view. Discover thoughtful everyday pieces, expressive African prints and finishing touches chosen by the owner.' %></p>
        <div class="hero-actions">
          <a class="btn fashion-primary" href="<%= heroSlide && heroSlide.link_url ? heroSlide.link_url : '/new-arrivals' %>"><%= heroSlide && heroSlide.link_text ? heroSlide.link_text : 'Explore new arrivals' %> <span aria-hidden="true">↗</span></a>
          <a class="btn fashion-outline" href="/c/traditional-wear">Shop Ghanaian heritage</a>
        </div>
        <div class="hero-index"><b>01</b><i></i> A considered collection, never a crowded marketplace</div>
      </div>
      <span class="hero-side-note">Style, with intention · Biahens Enterprise</span>
    </div>
  </section>

  <section class="container section-editorial" aria-labelledby="shopEditTitle">
    <div class="editorial-heading">
      <div>
        <span class="eyebrow">Find your feeling</span>
        <h2 id="shopEditTitle">Good style is personal.</h2>
      </div>
      <p>From easy everyday staples to pieces that celebrate where we come from — find something that feels like you.</p>
    </div>
    <div class="category-story-grid">
      <a class="category-story" href="/c/womens-clothing" aria-label="Shop women's style">
        <img src="/img/fashion/womens-ankara.jpg" alt="Ghanaian model wearing a contemporary Ankara dress" loading="lazy">
        <div class="category-story__text"><div><span>The everyday edit</span><h3>For her</h3></div><span class="category-story__arrow" aria-hidden="true">↗</span></div>
      </a>
      <a class="category-story" href="/c/mens-clothing" aria-label="Shop men's style">
        <img src="/img/fashion/mens-oxford.jpg" alt="Contemporary men's cotton shirt styling" loading="lazy">
        <div class="category-story__text"><div><span>Easy, elevated</span><h3>For him</h3></div><span class="category-story__arrow" aria-hidden="true">↗</span></div>
      </a>
      <a class="category-story" href="/c/traditional-wear" aria-label="Shop Ghanaian heritage fashion">
        <img src="/img/fashion/kente-style.jpg" alt="A refined Kente stole styled for today" loading="lazy">
        <div class="category-story__text"><div><span>Made of meaning</span><h3>Heritage</h3></div><span class="category-story__arrow" aria-hidden="true">↗</span></div>
      </a>
    </div>
  </section>

  <% if (newArrivals.length) { %>
    <section class="container collection-section" aria-labelledby="newInTitle">
      <div class="editorial-heading collection-heading">
        <div><span class="eyebrow">Fresh from the owner’s edit</span><h2 id="newInTitle">New in, worth knowing.</h2><p>New pieces, selected with care and ready for your wardrobe.</p></div>
        <a class="text-link" href="/new-arrivals">View the full edit <span aria-hidden="true">→</span></a>
      </div>
      <div class="home-product-grid">
        <% newArrivals.slice(0, 8).forEach(function (p) { %>
          <%- include('partials/product-card', { p: p }) %>
        <% }); %>
      </div>
    </section>
  <% } %>

  <section class="container owner-note" aria-labelledby="ownerNoteTitle">
    <div class="owner-note__copy">
      <span class="section-eyebrow">A different kind of online shop</span>
      <h2 id="ownerNoteTitle">A good eye.<br>A real person behind it.</h2>
      <p>Biahens Enterprise is a single-owner fashion store. The owner chooses every piece, sets every price and stands behind every order. No outside sellers, no mystery listings — just a smaller, more considered edit you can shop with confidence.</p>
    </div>
    <div class="owner-note__proof">
      <div class="proof-card"><b><%= productTotal %></b><span>fashion pieces in the live edit</span></div>
      <div class="proof-card"><b>01</b><span>owner accountable for every listing</span></div>
      <div class="proof-card"><b>GHS</b><span>straightforward cedi pricing</span></div>
      <div class="proof-card"><b>GH</b><span>delivery across Ghana</span></div>
    </div>
  </section>

  <section class="container" aria-labelledby="heritageTitle">
    <div class="heritage-banner">
      <img src="/img/fashion/kente-style.jpg" alt="" loading="lazy">
      <div class="heritage-banner__copy">
        <span>Rooted here. Ready everywhere.</span>
        <h2 id="heritageTitle">Heritage, made your own.</h2>
        <p>Discover Kente, Ankara and contemporary pieces that carry a little of home wherever you go.</p>
        <a href="/c/traditional-wear">Explore Ghanaian fashion <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <% if (bestSellers.length) { %>
    <section class="container collection-section" aria-labelledby="lovedTitle">
      <div class="editorial-heading collection-heading">
        <div><span class="eyebrow">Chosen again and again</span><h2 id="lovedTitle">The most loved pieces.</h2><p>Customer favourites from the Biahens collection.</p></div>
        <a class="text-link" href="/best-sellers">Shop customer favourites <span aria-hidden="true">→</span></a>
      </div>
      <div class="home-product-grid">
        <% bestSellers.slice(0, 4).forEach(function (p) { %>
          <%- include('partials/product-card', { p: p }) %>
        <% }); %>
      </div>
    </section>
  <% } %>

  <section class="container fashion-trust" aria-label="The Biahens promise">
    <div class="fashion-trust__item"><span class="trust-icon"><%- icon('check-circle') %></span><div><b>Chosen by the owner</b><span>One accountable seller. Every item is hand-picked.</span></div></div>
    <div class="fashion-trust__item"><span class="trust-icon"><%- icon('truck') %></span><div><b>Delivery across Ghana</b><span><%= settings.hero_note %>.</span></div></div>
    <div class="fashion-trust__item"><span class="trust-icon"><%- icon('refresh') %></span><div><b><%= settings.return_days %>-day returns</b><span>On eligible pieces, in original condition.</span></div></div>
    <div class="fashion-trust__item"><span class="trust-icon"><%- icon('support') %></span><div><b>Here when you need us</b><span>Get fit and order support from a real person.</span></div></div>
  </section>
</main>

<%- include('partials/footer') %>
