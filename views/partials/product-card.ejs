<%# expects: p (decorated product), optional wishSet (Set of product ids) %>
<%
  const off = discountPercent(p.price, p.compare_at_price);
  const img = imgSrc(p.image || (p.images_list && p.images_list[0]), { w: 640, h: 760, hint: p.category_name || p.name, name: p.name, palette: p.id % 8 });
  const wished = (typeof wishSet !== 'undefined' && wishSet) ? wishSet.has(p.id) : false;
%>
<article class="p-card" data-product-card="<%= p.id %>">
  <div class="p-media">
    <a class="p-image-link" href="/p/<%= p.slug %>" aria-label="View <%= p.name %>"><img src="<%= img %>" alt="<%= p.name %>" loading="lazy" width="640" height="760"></a>
    <span class="p-flags"><% if (!p.in_stock) { %><span class="badge danger">Sold out</span><% } else if (off >= 5) { %><span class="badge orange">−<%= off %>%</span><% } else if (p.is_featured) { %><span class="badge brand">Top pick</span><% } %></span>
    <button class="p-tool p-wish <%= wished ? 'active' : '' %>" type="button" data-wish="<%= p.id %>" aria-label="Save <%= p.name %> to wishlist" aria-pressed="<%= wished ? 'true' : 'false' %>" title="Save to wishlist"><%- icon('heart') %></button>
    <button class="p-quick" type="button" data-quickview="<%= p.slug %>" aria-label="Quick view <%= p.name %>"><%- icon('eye') %> Quick look</button>
  </div>
  <div class="p-body">
    <div class="p-card-meta"><% if (p.brand_name) { %><a class="p-brand" href="/b/<%= p.brand_slug %>"><%= p.brand_name %></a><% } %><% if (p.rating_count) { %><span class="p-rating"><%- icon('star') %><b><%= Number(p.rating_avg).toFixed(1) %></b><span>(<%= p.rating_count %>)</span></span><% } else { %><span class="p-rating new-product">New arrival</span><% } %></div>
    <a class="p-name clamp-2" href="/p/<%= p.slug %>"><%= p.name %></a>
    <div class="p-price-row"><span class="p-price"><%= settings.currency_symbol %> <%= money(p.price, { symbol: false }) %></span><% if (off) { %><span class="p-compare"><%= settings.currency_symbol %> <%= money(p.compare_at_price, { symbol: false }) %></span><% } %></div>
    <form class="p-actions" action="/cart/add" method="post">
      <input type="hidden" name="product_id" value="<%= p.id %>">
      <button class="btn p-add-btn block" type="submit" data-add-cart="<%= p.id %>" data-variants="<%= p.variant_count || 0 %>" data-slug="<%= p.slug %>" <% if (p.variant_count) { %>formaction="/p/<%= p.slug %>" formmethod="get"<% } %> <%= p.in_stock ? '' : 'disabled' %>><%- icon('bag') %><%= p.in_stock ? 'Add to bag' : 'Sold out' %><% if (p.in_stock) { %><%- icon('plus') %><% } %></button>
    </form>
  </div>
</article>
