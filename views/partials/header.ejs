<%
  const q = typeof query !== 'undefined' ? (query.q || '') : '';
  const categoryChoice = typeof query !== 'undefined' ? (query.category || '') : '';
  const roots = typeof menuCategories !== 'undefined' ? menuCategories : [];
  const allCategories = roots.flatMap(function (root) { return [root].concat(root.children || []); });
  const navItems = [
    { slug: 'electronics', label: 'Electronics' },
    { slug: 'fashion', label: 'Fashion' },
    { slug: 'home-kitchen', label: 'Home & kitchen' },
    { slug: 'beauty-health', label: 'Beauty & health' },
    { slug: 'groceries', label: 'Groceries' },
  ].filter(function (item) { return allCategories.some(function (cat) { return cat.slug === item.slug; }); });
  const cartData = typeof cart !== 'undefined' ? cart : { items: [], count: 0, total: 0, subtotal: 0, isEmpty: true };
%>
<a class="skip-link" href="#main">Skip to content</a>
<header class="site-header" id="siteHeader">
  <% if (settings.announcement_on === 'true' || settings.announcement_on === true) { %>
    <div class="announce">
      <div class="container announce-inner">
        <span class="announce-location"><span class="ghana-flag" aria-hidden="true"></span> Made for your everyday.</span>
        <a class="announce-message" href="/new-arrivals"><%= settings.announcement %> <%- icon('arrow-right') %></a>
        <span class="announce-currency">Ghana <span>·</span> <%= settings.currency %> <%- icon('chevron-down') %></span>
      </div>
    </div>
  <% } %>

  <div class="hdr-main">
    <div class="container hdr-main-grid">
      <button class="hdr-burger" type="button" id="burgerBtn" aria-label="Open menu" aria-expanded="false" aria-controls="drawer"><%- icon('menu') %></button>
      <a class="brandmark" href="/" aria-label="<%= settings.store_name %> home">
        <span class="brand-symbol" aria-hidden="true"><%- icon('asterisk') %></span>
        <span class="brand-name"><%= settings.store_name %><span class="brand-dot">.</span></span>
      </a>

      <div class="hdr-search">
        <form class="search-form" action="/search" method="get" role="search" id="searchForm" autocomplete="off">
          <span class="search-leading" aria-hidden="true"><%- icon('search') %></span>
          <input class="search-input" type="search" name="q" id="searchInput" value="<%= q %>" placeholder="Search for your next favourite…" role="combobox" aria-label="Search products" aria-controls="suggestBox" aria-autocomplete="list" aria-haspopup="listbox" aria-expanded="false">
          <select class="search-cat" name="category" aria-label="Search within a category">
            <option value="" <%= !categoryChoice ? 'selected' : '' %>>All categories</option>
            <% roots.forEach(function (root) { %>
              <option value="<%= root.slug %>" <%= categoryChoice === root.slug ? 'selected' : '' %>><%= root.name %></option>
              <% (root.children || []).forEach(function (child) { %>
                <option value="<%= child.slug %>" <%= categoryChoice === child.slug ? 'selected' : '' %>>&nbsp; <%= child.name %></option>
              <% }); %>
            <% }); %>
          </select>
          <button class="search-btn" type="submit" aria-label="Search"><%- icon('arrow-right') %></button>
        </form>
        <div class="suggest" id="suggestBox" role="listbox" aria-label="Search suggestions"></div>
      </div>

      <div class="hdr-actions">
        <div class="dd" id="accountDD">
          <button class="hdr-btn" type="button" aria-haspopup="true" aria-expanded="false" aria-controls="accountPanel" aria-label="<%= user ? user.name.split(' ')[0] + ' account menu' : 'Account menu' %>">
            <%- icon('user') %><span class="lbl"><b><%= user ? user.name.split(' ')[0] : 'Account' %></b></span>
          </button>
          <div class="dd-panel account-panel" id="accountPanel">
            <% if (user) { %>
              <div class="dd-head"><b>Hello, <%= user.name.split(' ')[0] %>.</b><span>Welcome back to your kind of style.</span></div>
              <div class="dd-list">
                <% if (user.role !== 'customer') { %><a href="/admin"><%- icon('settings') %> Store dashboard</a><% } %>
                <a href="/account"><%- icon('grid') %> My account</a>
                <a href="/account/orders"><%- icon('package') %> My orders</a>
                <a href="/account/wishlist"><%- icon('heart') %> My wishlist</a>
                <a href="/account/addresses"><%- icon('pin') %> Addresses</a>
              </div>
              <div class="dd-foot"><form action="/logout" method="post"><button class="btn ghost sm block" type="submit">Sign out</button></form></div>
            <% } else { %>
              <div class="dd-head"><b>Your next favourite awaits.</b><span>Sign in for a little more POINTGH.</span></div>
              <div class="dd-list"><a href="/login"><%- icon('user') %> Sign in</a><a href="/register"><%- icon('plus') %> Create an account</a><a href="/track-order"><%- icon('package') %> Track my order</a></div>
              <div class="dd-foot"><a class="btn primary sm block" href="/register">Make yourself at home <%- icon('arrow-right') %></a></div>
            <% } %>
          </div>
        </div>
        <a class="hdr-btn wishlist-link" href="<%= user ? '/account/wishlist' : '/login' %>" aria-label="My wishlist, <%= wishlistCount || 0 %> items">
          <%- icon('heart') %><span class="sr-only">Wishlist</span>
          <span class="count-chip wish-count" data-wish-count <%= wishlistCount ? '' : 'hidden' %>><%= wishlistCount || 0 %></span>
        </a>
        <span class="action-divider" aria-hidden="true"></span>
        <div class="dd" id="cartDD">
          <button class="hdr-btn cart" type="button" aria-haspopup="true" aria-expanded="false" aria-controls="miniCart" aria-label="Shopping bag, <%= cartData.count || 0 %> items">
            <%- icon('bag') %><span class="lbl"><b>Bag</b></span> <span class="count-chip" data-cart-count aria-hidden="true"><%= cartData.count || 0 %></span>
          </button>
          <div class="dd-panel minicart" id="miniCart">
            <div class="dd-head row between"><div><b>Your shopping bag</b><span><span data-cart-count><%= cartData.count || 0 %></span> item(s), all good choices.</span></div><a href="/cart" class="btn ghost sm">View bag</a></div>
            <div class="minicart-items" data-minicart-items>
              <% if (cartData.isEmpty) { %>
                <div class="mc-empty"><span class="empty-bag-icon"><%- icon('bag') %></span><b>Room for something good.</b><p>Your next favourite is just a few clicks away.</p><a class="btn primary sm" href="/new-arrivals">Start exploring <%- icon('arrow-right') %></a></div>
              <% } else { %>
                <% cartData.items.slice(0, 4).forEach(function (item) { %>
                  <div class="mc-item">
                    <img src="<%= imgSrc(item.image, { w: 120, h: 120, hint: item.product.category_name, name: item.product.name }) %>" alt="<%= item.product.name %>" loading="lazy">
                    <div class="grow"><div class="n clamp-2"><a href="/p/<%= item.product.slug %>"><%= item.product.name %></a></div>
                      <% if (item.variant) { %><div class="v"><%= item.variant.title %></div><% } %>
                      <div class="p"><%= settings.currency_symbol %> <%= Number(item.unit_price).toFixed(2) %> <span class="muted small">× <%= item.qty %></span></div>
                    </div>
                    <button class="rm" type="button" data-remove-item="<%= item.id %>" aria-label="Remove <%= item.product.name %>">&times;</button>
                  </div>
                <% }); %>
              <% } %>
            </div>
            <div class="mc-foot" data-minicart-footer <%= cartData.isEmpty ? 'hidden' : '' %>>
              <div class="mc-row"><span>Subtotal</span><b data-cart-subtotal><%= settings.currency_symbol %> <%= Number(cartData.subtotal || 0).toFixed(2) %></b></div>
              <div class="mc-row" data-cart-discount-row <%= cartData.discount > 0 ? '' : 'hidden' %>><span>Coupon discount</span><b data-cart-discount>− <%= settings.currency_symbol %> <%= Number(cartData.discount || 0).toFixed(2) %></b></div>
              <div class="mc-row" data-cart-vat-row <%= cartData.taxRate > 0 ? '' : 'hidden' %>><span data-cart-vat-label><%= h.vatLabel(cartData.taxRate) %></span><b data-cart-tax><%= settings.currency_symbol %> <%= Number(cartData.tax || 0).toFixed(2) %></b></div>
              <p class="small muted">VAT is added after discounts. Delivery calculated at checkout.</p>
              <a class="btn primary block" href="/checkout"><%= user ? 'Checkout' : 'Sign in to checkout' %> <%- icon('arrow-right') %></a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <nav class="hdr-nav" aria-label="Shop categories">
    <div class="container hdr-nav-row">
      <button class="cat-trigger" type="button" id="megaBtn" aria-expanded="false" aria-controls="megaMenu"><%- icon('grid') %> Shop by category <%- icon('chevron-down') %></button>
      <span class="nav-divider" aria-hidden="true"></span>
      <div class="nav-scroll">
        <a class="nav-link <%= currentPath === '/new-arrivals' ? 'active' : '' %>" href="/new-arrivals">New arrivals <span class="nav-new">NEW</span></a>
        <% navItems.forEach(function (item) { %><a class="nav-link <%= currentPath === '/c/' + item.slug ? 'active' : '' %>" href="/c/<%= item.slug %>"><%= item.label %></a><% }); %>
        <a class="nav-link" href="/best-sellers">Bestsellers</a>
        <a class="nav-link hot" href="/deals">Sale <%- icon('tag') %></a>
      </div>
      <a class="nav-link nav-support" href="/track-order"><%- icon('package') %> Track order</a>
    </div>
    <div class="mega" id="megaMenu" inert>
      <div class="container mega-grid">
        <% roots.forEach(function (root) { %><div class="mega-col"><a class="mega-title" href="/c/<%= root.slug %>"><%= root.name %> <%- icon('arrow-right') %></a><% (root.children || []).forEach(function (child) { %><a href="/c/<%= child.slug %>"><%= child.name %></a><% }); %></div><% }); %>

      </div>
    </div>
  </nav>
</header>

<div class="drawer" id="drawer" aria-hidden="true" inert>
  <div class="drawer-backdrop" data-drawer-close></div>
  <div class="drawer-panel" role="dialog" aria-modal="true" aria-label="Shop navigation" tabindex="-1">
    <div class="drawer-head"><a class="brandmark" href="/"><span class="brand-symbol" aria-hidden="true"><%- icon('asterisk') %></span><span class="brand-name"><%= settings.store_name %>.</span></a><button class="drawer-close" type="button" data-drawer-close aria-label="Close menu"><%- icon('x') %></button></div>
    <div class="drawer-body"><nav class="drawer-nav" aria-label="Mobile shop navigation">
      <a href="/new-arrivals">New arrivals <span class="nav-new">NEW</span></a><a href="/best-sellers">Bestsellers</a><a class="sale-link" href="/deals">Sale &amp; good finds <%- icon('tag') %></a>
      <div class="group-title">Shop all departments</div>
      <% roots.forEach(function (root) { %><details class="drawer-department"><summary><%= root.name %></summary><a class="sub" href="/c/<%= root.slug %>">Shop all <%= root.name.toLowerCase() %></a><% (root.children || []).forEach(function (child) { %><a class="sub" href="/c/<%= child.slug %>"><%= child.name %></a><% }); %></details><% }); %>
      <div class="group-title">Your POINTGH</div><a href="<%= user ? '/account' : '/login' %>">My account</a><a href="<%= user ? '/account/wishlist' : '/login' %>">My wishlist</a><a href="/track-order">Track an order</a><a href="/contact">Contact support</a>
      <% if (user && user.role !== 'customer') { %><a href="/admin">Store dashboard</a><% } %>
    </nav></div>
    <div class="drawer-foot"><a class="btn primary block" href="/contact"><%- icon('message') %> Talk to a real person</a><p class="center small muted"><%= settings.support_hours %></p></div>
  </div>
</div>

<nav class="m-bottom" aria-label="Quick navigation"><div class="container">
  <a href="/" class="<%= currentPath === '/' ? 'active' : '' %>"><%- icon('home') %><span>Home</span></a>
  <a href="/categories" class="<%= currentPath === '/categories' || currentPath.indexOf('/c/') === 0 ? 'active' : '' %>"><%- icon('grid') %><span>Shop</span></a>
  <a href="/deals" class="<%= currentPath === '/deals' ? 'active' : '' %>"><%- icon('tag') %><span>Sale</span></a>
  <a href="<%= user ? '/account/wishlist' : '/login' %>"><%- icon('heart') %><span>Wishlist</span></a>
  <a href="/cart" class="<%= currentPath.indexOf('/cart') === 0 ? 'active' : '' %>"><%- icon('bag') %><span>Bag <span data-cart-count><%= cartData.count || 0 %></span></span></a>
</div></nav>
