<% if (settings.newsletter_on === 'true' || settings.newsletter_on === true) { %>
<section class="container newsletter-section" aria-labelledby="newsletterTitle">
  <div class="newsletter-copy"><span class="eyebrow">LET'S KEEP IN TOUCH</span><h2 id="newsletterTitle">Good finds.<br>Straight to your inbox.</h2><p>New arrivals, little surprises, and 5% off your next order.</p></div>
  <div class="newsletter-signup"><form class="newsletter-form" action="/newsletter" method="post" data-newsletter-form><label class="sr-only" for="newsletterEmail">Your email address</label><span class="newsletter-icon" aria-hidden="true"><%- icon('mail') %></span><input type="email" name="email" id="newsletterEmail" placeholder="Your email address" autocomplete="email" required><button class="btn" type="submit">Count me in <%- icon('arrow-right') %></button></form><p class="newsletter-note" data-newsletter-status role="status">Just the good stuff. Unsubscribe whenever you like.</p></div>
  <span class="newsletter-decoration" aria-hidden="true"><%- icon('asterisk') %></span>
</section>
<% } %>
<footer class="site-footer"><div class="container">
  <div class="footer-top">
    <div class="footer-brand"><a class="brandmark" href="/" aria-label="<%= settings.store_name %> home"><span class="brand-symbol" aria-hidden="true"><%- icon('asterisk') %></span><span class="brand-name"><%= settings.store_name %>.</span></a><p>Good style. Great finds. A little more you.<br>Personally picked in Accra, delivered across Ghana.</p><div class="socials"><% if (settings.instagram) { %><a href="<%= settings.instagram %>" aria-label="Instagram" rel="noopener" target="_blank"><%- icon('instagram') %></a><% } %><% if (settings.facebook) { %><a href="<%= settings.facebook %>" aria-label="Facebook" rel="noopener" target="_blank"><%- icon('facebook') %></a><% } %><% if (settings.tiktok) { %><a href="<%= settings.tiktok %>" aria-label="TikTok" rel="noopener" target="_blank"><%- icon('tiktok') %></a><% } %><a href="https://wa.me/<%= (settings.support_whatsapp || '').replace(/[^0-9]/g, '') %>" aria-label="WhatsApp" rel="noopener" target="_blank"><%- icon('whatsapp') %></a></div><span class="footer-origin"><span class="ghana-flag" aria-hidden="true"></span> From Ghana, with good taste.</span></div>

    <div><h3>Here to help</h3><ul><li><a href="/track-order">Track your order</a></li><li><a href="/shipping-delivery">Delivery information</a></li><li><a href="/returns-refunds">Returns &amp; refunds</a></li><li><a href="/faq">Frequently asked questions</a></li><li><a href="/account">My account</a></li><li><a href="/about">Our story</a></li></ul></div>
    <div class="footer-contact"><h3>Let's talk</h3><p>Something on your mind?<br>There's a real person on the other end.</p><a class="footer-contact-link" href="tel:<%= settings.support_phone.replace(/\s/g, '') %>"><%- icon('phone') %> <%= settings.support_phone %></a><a class="footer-contact-link" href="mailto:<%= settings.support_email %>"><%- icon('mail') %> Email our team <%- icon('external') %></a><span class="footer-hours"><%= settings.support_hours %></span><a class="footer-visit" href="/contact"><%- icon('pin') %> <%= settings.address_city %>, Ghana</a></div>
  </div>
  <div class="footer-security"><%- icon('lock') %> Account checkout. Your orders, all in one place.</div>
  <div class="footer-bottom"><div>&copy; <%= new Date().getFullYear() %> <%= settings.store_name %>. All rights reserved.</div><div class="footer-links"><a href="/privacy">Privacy policy</a><a href="/terms">Terms of service</a><% if (!user || user.role === 'customer') { %><a href="/admin/login">Store owner login <%- icon('external') %></a><% } else { %><a href="/admin">Store dashboard <%- icon('external') %></a><% } %></div></div>
</div></footer>
<button class="to-top" id="toTop" type="button" aria-label="Back to top"><%- icon('arrow-up') %></button>
<a class="whatsapp-fab" href="https://wa.me/<%= (settings.support_whatsapp || '').replace(/[^0-9]/g, '') %>?text=Hello%20<%= encodeURIComponent(settings.store_name) %>%2C%20I%20need%20help%20with%20an%20order" target="_blank" rel="noopener" aria-label="Chat with our team on WhatsApp"><%- icon('whatsapp') %></a>
<%- include('quickview') %>
<script src="/js/site.js?v=2.2" defer></script>
<% if (typeof extraJs !== 'undefined' && extraJs) { %><script src="<%= extraJs %>" defer></script><% } %>
</body>
</html>
